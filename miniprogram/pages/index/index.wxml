<view class="home">
  <!-- 加载中 -->
  <view class="state-box" wx:if="{{loading}}">
    <text class="state-title">正在登录…</text>
    <text class="state-sub">首次进入需完成微信静默授权</text>
  </view>

  <!-- 登录失败 -->
  <view class="state-box state-err" wx:elif="{{loginError}}">
    <text class="state-title">登录未完成</text>
    <text class="state-sub">{{loginError}}</text>
    <button class="btn-primary state-btn" bindtap="onRetryLogin">重试</button>
  </view>

  <block wx:else>
  <!-- 顶部卡片 -->
  <view class="hero">
    <view class="hero-user">
      <view class="hero-avatar">{{initial}}</view>
      <view class="hero-info">
        <text class="hero-name">{{nickname}}</text>
        <text class="hero-sub">欢迎回来，继续牌局</text>
      </view>
    </view>
    <view class="hero-right">
      <view class="hero-cards" bindtap="onCardsTap">
        <text class="cards-num">{{roomCards}}</text>
        <text class="cards-label">房卡</text>
        <text class="cards-add">+</text>
      </view>
      <view class="hero-set" bindtap="onSettingsTap"><view class="ic ic-gear set-ico"></view></view>
    </view>
  </view>

  <!-- 牌桌显示名还是建档占位值 → 引导用微信昵称（设一次，牌桌与同桌好友都跟着变） -->
  <view class="nick-tip" wx:if="{{nickDefault}}" bindtap="onGoProfile">
    <text class="nick-tip-i">✎</text>
    <text class="nick-tip-t">牌桌显示名还是默认的「{{nickname}}」，用微信昵称更方便同桌认人</text>
    <text class="nick-tip-a">设置</text>
  </view>

  <!-- 游戏模式 -->
  <view class="modes">
    <!-- 好友房 -->
    <view class="mode mode-friend" bindtap="onFriendTap">
      <view class="mode-icon ic ic-friend"></view>
      <view class="mode-body">
        <text class="mode-title">好友房</text>
        <text class="mode-desc">创建房间邀请好友，或输入房号加入</text>
      </view>
      <text class="mode-arrow">›</text>
    </view>

    <!-- AI 对战 -->
    <view class="mode mode-ai" bindtap="onAIQuick" bindlongpress="onAIMode">
      <view class="mode-icon ic ic-ai"></view>
      <view class="mode-body">
        <text class="mode-title">AI 对战</text>
        <text class="mode-desc">与 AI 玩家练习，适合新手熟悉规则</text>
      </view>
      <text class="mode-arrow">›</text>
    </view>

    <!-- SNG 淘汰赛（批⑤） -->
    <view class="mode mode-sng" bindtap="onSngConfigTap">
      <view class="mode-icon ic ic-rank"></view>
      <view class="mode-body">
        <text class="mode-title">SNG 淘汰赛</text>
        <text class="mode-desc">筹码归零即淘汰，活到最后夺冠</text>
      </view>
      <text class="mode-arrow">›</text>
    </view>

    <!-- 每日一题 -->
    <view class="mode mode-puzzle" bindtap="onPuzzleTap">
      <view class="mode-icon ic ic-cards"></view>
      <view class="mode-body">
        <text class="mode-title">每日一题</text>
        <text class="mode-desc">局面挑战，练读牌与赔率判断</text>
      </view>
      <text class="mode-arrow">›</text>
    </view>

    <!-- 快速匹配 -->
    <view class="mode mode-rank" bindtap="onRankMode">
      <view class="mode-icon ic ic-rank"></view>
      <view class="mode-body">
        <text class="mode-title">快速匹配</text>
        <text class="mode-desc">随机匹配对手（需确认平台合规政策）</text>
      </view>
      <text class="mode-tag" wx:if="{{!rankEnabled}}">暂未开放</text>
      <text class="mode-arrow" wx:else>›</text>
    </view>
  </view>

  <!-- 我的房间：区分加载中 / 加载失败 / 空列表 / 有房间 -->
  <view class="myrooms" wx:if="{{roomsLoading}}">
    <view class="sec-head">
      <text class="sec-title">我的房间</text>
      <text class="sec-count">加载中…</text>
    </view>
    <view class="room-skel" wx:for="{{[1]}}" wx:key="*this"></view>
  </view>
  <view class="myrooms" wx:elif="{{roomsError}}">
    <view class="sec-head">
      <text class="sec-title">我的房间</text>
    </view>
    <view class="room-state">
      <text class="room-state-t">加载失败</text>
      <text class="room-state-s">网络不太顺畅，重试一下</text>
      <view class="room-retry" bindtap="onRetryRooms">重试</view>
    </view>
  </view>
  <view class="myrooms" wx:elif="{{myRooms.length}}">
    <view class="sec-head">
      <text class="sec-title">我的房间</text>
      <text class="sec-count">{{myRooms.length}} 个进行中</text>
    </view>
    <view class="room-card" wx:for="{{myRooms}}" wx:key="roomNo"
          bindtap="onEnterRoom" data-room="{{item.roomNo}}"
          data-max="{{item.maxPlayers}}" data-dur="{{item.durationMin}}">
      <view class="room-ico ic ic-friend"></view>
      <view class="room-info">
        <text class="room-no">房间 {{item.roomNo}}</text>
        <text class="room-meta">{{item.maxPlayers}} 人桌 · {{item.durText}} · {{item.liveText}}</text>
      </view>
      <view class="room-del" catchtap="onCloseRoom" data-room="{{item.roomNo}}">删除</view>
      <view class="room-enter">{{item.live ? '继续' : '进入'}} <text class="chev">›</text></view>
    </view>
  </view>

  <!-- 我的战绩 -->
  <view class="stats" bindtap="onGoProfile">
    <view class="stat-item">
      <text class="stat-n">{{stats.hands}}</text>
      <text class="stat-l">总手数</text>
    </view>
    <view class="stat-item">
      <text class="stat-n">{{stats.wins}}</text>
      <text class="stat-l">胜场</text>
    </view>
    <view class="stat-item">
      <text class="stat-n {{stats.net >= 0 ? 'up' : 'down'}}">{{stats.netText}}</text>
      <text class="stat-l">盈亏</text>
    </view>
    <view class="stat-item">
      <text class="stat-n">{{stats.rate}}</text>
      <text class="stat-l">胜率</text>
    </view>
    <text class="stats-arrow">›</text>
  </view>

  <!-- 规则速览 -->
  <view class="rules">
    <text class="rules-title">新手上路 · 牌型速览</text>
    <view class="rule-row" wx:for="{{handRanks}}" wx:key="name">
      <text class="rule-name">{{item.name}}</text>
      <text class="rule-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="footer-note">
    体验版 · 功能演示中，正式版需完成版号与备案
  </view>
  </block>

  <!-- 加入房间弹窗 -->
  <view class="join-mask" wx:if="{{joinShow}}" bindtap="onJoinCancel">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">加入房间</text>
      <text class="join-sub">输入好友告诉你的 6 位房间号</text>
      <input class="join-input" type="number" maxlength="6" placeholder="房间号"
             value="{{joinNo}}" bindinput="onJoinInput" />
      <view class="join-btns">
        <button class="btn-ghost join-btn" bindtap="onJoinCancel">取消</button>
        <button class="btn-primary join-btn" bindtap="onJoinConfirm">加入</button>
      </view>
    </view>
  </view>

  <!-- 创建好友房：人数 2–9 逐人可调；时长 10 分钟为一档（可切不限时） -->
  <view class="join-mask" wx:if="{{createShow}}" bindtap="onCreateClose">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">创建好友房</text>
      <text class="join-sub">消耗 1 张房卡 · 创建后规则不可修改</text>

      <!-- 限定人数 -->
      <view class="field">
        <view class="field-head">
          <text class="field-name">限定人数</text>
          <text class="field-hint">2 – 9 人，2 人即可开局</text>
        </view>
        <view class="stepper">
          <view class="step-btn {{cMax <= 2 ? 'off' : ''}}" data-step="-1" bindtap="onMaxStep">−</view>
          <view class="step-val">
            <text class="sv-num">{{cMax}}</text><text class="sv-unit">人</text>
          </view>
          <view class="step-btn {{cMax >= 9 ? 'off' : ''}}" data-step="1" bindtap="onMaxStep">+</view>
        </view>
        <view class="chips">
          <view class="chip {{cMax === item ? 'on' : ''}}" wx:for="{{maxPresets}}" wx:key="*this"
                data-max="{{item}}" bindtap="onPickMax">{{item}} 人</view>
        </view>
      </view>

      <!-- 游戏时长 -->
      <view class="field">
        <view class="field-head">
          <text class="field-name">游戏时长</text>
          <text class="field-hint">10 分钟为一档</text>
        </view>
        <view class="stepper">
          <view class="step-btn" data-step="-1" bindtap="onDurStep">−</view>
          <view class="step-val">
            <block wx:if="{{cDur > 0}}"><text class="sv-num">{{cDur}}</text><text class="sv-unit">分钟</text></block>
            <text class="sv-word" wx:else>不限时</text>
          </view>
          <view class="step-btn" data-step="1" bindtap="onDurStep">+</view>
        </view>
        <view class="chips">
          <view class="chip {{cDur === item.v ? 'on' : ''}}" wx:for="{{durPresets}}" wx:key="v"
                data-d="{{item.v}}" bindtap="onPickDur">{{item.t}}</view>
          <view class="chip chip-unl {{cDur === 0 ? 'on' : ''}}" bindtap="onToggleUnlimited">不限时</view>
        </view>
      </view>

      <!-- 涨盲间隔（批④）：每 N 分钟 sb/bb 翻倍，0 = 不涨盲 -->
      <view class="field">
        <view class="field-head">
          <text class="field-name">涨盲间隔</text>
          <text class="field-hint">每 N 分钟盲注翻倍，逼迫僵局</text>
        </view>
        <view class="chips">
          <view class="chip {{cBlind === item.v ? 'on' : ''}}" wx:for="{{blindPresets}}" wx:key="v"
                data-b="{{item.v}}" bindtap="onPickBlind">{{item.t}}</view>
        </view>
      </view>

      <text class="dlg-note">{{cMax}} 人桌 · {{durLabel}}{{cBlind ? ' · 每 ' + cBlind + ' 分涨盲' : ''}}</text>
      <text class="dlg-note-sub">倒计时结束时自动结算本局，并统计所有参与人的盈亏</text>

      <view class="join-btns">
        <button class="btn-ghost join-btn" bindtap="onCreateClose">取消</button>
        <button class="btn-primary join-btn" bindtap="onCreateConfirm">创建 · 1 房卡</button>
      </view>
    </view>
  </view>

  <!-- SNG 淘汰赛配置弹窗（选桌型，确认后弹难度档） -->
  <view class="join-mask" wx:if="{{sngShow}}" bindtap="onSngConfigClose">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">SNG 淘汰赛</text>
      <text class="join-sub">不消耗房卡 · 筹码归零即淘汰，活到最后夺冠</text>

      <!-- 限定人数 -->
      <view class="field">
        <view class="field-head">
          <text class="field-name">桌型人数</text>
          <text class="field-hint">2 – 9 人，2 人即可开局</text>
        </view>
        <view class="stepper">
          <view class="step-btn {{sngMax <= 2 ? 'off' : ''}}" data-step="-1" bindtap="onSngMaxStep">−</view>
          <view class="step-val">
            <text class="sv-num">{{sngMax}}</text><text class="sv-unit">人</text>
          </view>
          <view class="step-btn {{sngMax >= 9 ? 'off' : ''}}" data-step="1" bindtap="onSngMaxStep">+</view>
        </view>
        <view class="chips">
          <view class="chip {{sngMax === item ? 'on' : ''}}" wx:for="{{maxPresets}}" wx:key="*this"
                data-max="{{item}}" bindtap="onSngPickMax">{{item}} 人</view>
        </view>
      </view>

      <text class="dlg-note">{{sngMax}} 人桌 · 每 3 分涨盲 · 不限时长</text>
      <text class="dlg-note-sub">下一步选难度档（新手 / 进阶 / 高手）</text>

      <view class="join-btns">
        <button class="btn-ghost join-btn" bindtap="onSngConfigClose">取消</button>
        <button class="btn-primary join-btn" bindtap="onSngConfigConfirm">下一步</button>
      </view>
    </view>
  </view>

  <!-- 房卡：免费获取途径（体验版不做任何货币化） -->
  <view class="join-mask" wx:if="{{cardsShow}}" bindtap="onCardsClose">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">获取房卡</text>
      <text class="join-sub">当前 {{roomCards}} 张 · 创建好友房消耗 1 张，AI 对战不消耗</text>

      <view class="card-row">
        <view class="card-gain">
          <text class="cg-name">每日领取</text>
          <text class="cg-desc">每天 {{claim.dailyCount}} 张，次日刷新</text>
        </view>
        <button class="btn-primary cg-btn {{claim.dailyReady ? '' : 'off'}}"
                disabled="{{!claim.dailyReady}}" bindtap="onClaimDaily">
          {{claim.dailyReady ? '领取 +' + claim.dailyCount : '今日已领'}}
        </button>
      </view>

      <view class="card-row">
        <view class="card-gain">
          <text class="cg-name">对局奖励</text>
          <text class="cg-desc">每累计 {{claim.handsPerCard}} 手领 1 张（单次最多 5）</text>
        </view>
        <button class="btn-primary cg-btn {{claim.handCards > 0 ? '' : 'off'}}"
                disabled="{{claim.handCards === 0}}" bindtap="onClaimHands">
          {{claim.handCards > 0 ? '领取 +' + claim.handCards : '再打 ' + claim.handsToNext + ' 手'}}
        </button>
      </view>

      <view class="card-row">
        <view class="card-gain">
          <text class="cg-name">加入好友的房间</text>
          <text class="cg-desc">不消耗房卡，输入 6 位房号即可</text>
        </view>
        <button class="btn-ghost cg-btn" bindtap="onJoinFromCards">去加入</button>
      </view>

      <text class="opt-note">体验版不提供任何付费充值；正式版若做房卡售卖，需企业主体 + 支付资质 + 版号备案</text>

      <view class="join-btns">
        <button class="btn-ghost join-btn" bindtap="onCardsClose">关闭</button>
        <button class="btn-primary join-btn" bindtap="onAIMode">先玩 AI 桌</button>
      </view>
    </view>
  </view>

  <!-- 牌桌设置（参考主流扑克 App 的 Table Appearance） -->
  <view class="join-mask" wx:if="{{setShow}}" bindtap="onSettingsClose">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">牌桌设置</text>
      <text class="join-sub">四色牌与反馈效果，下次进入牌桌生效</text>

      <view class="set-row" data-k="fourColor" bindtap="onToggle">
        <view class="set-info">
          <text class="set-name">四色牌</text>
          <text class="set-desc">♠黑 / ♣绿 / ♦蓝 / ♥红，更易分辨花色</text>
        </view>
        <view class="switch {{sFourColor ? 'on' : ''}}"><view class="knob"></view></view>
      </view>

      <view class="set-row" data-k="sound" bindtap="onToggle">
        <view class="set-info">
          <text class="set-name">音效</text>
          <text class="set-desc">发牌、下注、轮到我等合成音效</text>
        </view>
        <view class="switch {{sSound ? 'on' : ''}}"><view class="knob"></view></view>
      </view>

      <view class="set-row" data-k="vibrate" bindtap="onToggle">
        <view class="set-info">
          <text class="set-name">震动反馈</text>
          <text class="set-desc">每次行动时短震动提示</text>
        </view>
        <view class="switch {{sVibrate ? 'on' : ''}}"><view class="knob"></view></view>
      </view>

      <view class="set-row" data-k="animation" bindtap="onToggle">
        <view class="set-info">
          <text class="set-name">牌桌动画</text>
          <text class="set-desc">发牌、下注与光效动画</text>
        </view>
        <view class="switch {{sAnim ? 'on' : ''}}"><view class="knob"></view></view>
      </view>

      <view class="join-btns">
        <button class="btn-primary join-btn" bindtap="onSettingsClose">完成</button>
      </view>
    </view>
  </view>

  <!-- 创建房间成功：原生分享按钮 + 复制房号 + 直接进入，少一次跳转 -->
  <view class="join-mask" wx:if="{{createdShow}}" bindtap="onCreatedClose">
    <view class="join-dialog" catchtap="onBlockTap">
      <text class="join-title">房间已创建</text>
      <text class="join-sub">{{createdDesc}}</text>
      <view class="created-no">
        <text class="created-label">房间号</text>
        <text class="created-num" bindtap="onCreatedCopy">{{createdRoomNo}}</text>
      </view>
      <view class="join-btns created-btns">
        <button class="btn-ghost join-btn" bindtap="onCreatedClose">稍后</button>
        <button class="btn-ghost join-btn" bindtap="onCreatedCopy">复制房号</button>
        <button class="btn-primary join-btn" open-type="share">邀请好友</button>
      </view>
      <view class="join-btns">
        <button class="btn-primary join-btn enter-btn" bindtap="onCreatedEnter">进入房间</button>
      </view>
    </view>
  </view>
</view>
