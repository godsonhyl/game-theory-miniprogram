<view class="profile">
  <!-- 加载态：档案与战绩读取中，骨架屏避免全空闪烁 -->
  <view class="loading-box" wx:if="{{loading}}">
    <view class="skel skel-circle"></view>
    <view class="skel skel-line w40"></view>
    <view class="skel skel-line w30"></view>
    <view class="loading-sum">
      <view class="skel skel-num"></view>
      <view class="skel skel-num"></view>
      <view class="skel skel-num"></view>
    </view>
    <view class="skel skel-block"></view>
    <view class="skel skel-block"></view>
    <text class="loading-tip">正在读取战绩…</text>
  </view>

  <block wx:else>
  <view class="head">
    <view class="head-badge ic ic-spade"></view>
    <view class="head-avatar">{{initial}}</view>

    <!-- 昵称：未进入编辑 → 显示当前名字 + 改名入口 -->
    <view class="head-row" wx:if="{{!editing}}">
      <text class="head-name">{{nickname}}</text>
      <view class="nick-edit" bindtap="onEditNick">改名</view>
    </view>

    <!--
      编辑态：微信官方「头像昵称填写能力」的昵称输入框。
      用户点一下输入框，键盘上方会弹出「用微信昵称」，一键填入本人的微信昵称
      —— 这是目前唯一合规且能拿到真实昵称的途径（wx.getUserProfile 早已回收）。
    -->
    <input wx:else class="nick-input" type="nickname" value="{{nickInput}}"
           placeholder="点此填入微信昵称" placeholder-class="nick-ph"
           maxlength="{{nickMax}}" bindinput="onNickInput" bindconfirm="onSaveNick" />
    <view class="nick-ops" wx:if="{{editing}}">
      <view class="nick-btn" bindtap="onCancelNick">取消</view>
      <view class="nick-btn primary" bindtap="onSaveNick">保存</view>
    </view>
    <text class="head-tip" wx:if="{{editing || nickDefault}}">牌桌上按这个名字显示，同桌好友可见</text>

    <text class="head-sub">玩家画像与历史战绩</text>
  </view>

  <view class="summary">
    <view class="sum-item">
      <text class="sum-n">{{stats.hands}}</text>
      <text class="sum-l">总手数</text>
    </view>
    <view class="sum-item">
      <text class="sum-n">{{stats.wins}}</text>
      <text class="sum-l">胜场</text>
    </view>
    <view class="sum-item">
      <text class="sum-n {{stats.net >= 0 ? 'up' : 'down'}}">{{stats.netText}}</text>
      <text class="sum-l">累计盈亏</text>
    </view>
  </view>

  <view class="section">
    <view class="sec-head"><view class="sec-ico ic ic-spade"></view><text class="sec-title">打法风格</text></view>
    <view class="style-card">
      <view class="style-row">
        <text class="style-k">胜率倾向</text>
        <text class="style-v">{{style}}</text>
      </view>
      <!-- 风格画像（第三期）：吃本地复盘缓存的行为统计。样本不足时不硬算 -->
      <view class="style-insufficient" wx:if="{{!styleAnalysis || styleAnalysis.insufficient}}">
        样本不足（{{styleAnalysis.sample || 0}}/{{vpipMin}}局），多打几局再看风格画像
      </view>
      <block wx:else>
        <view class="style-row"><text class="style-k">打法象限</text>
          <text class="style-v {{styleAnalysis.quadrantTag}}">{{styleAnalysis.quadrant}}</text></view>
        <view class="style-row"><text class="style-k">翻前入池</text>
          <text class="style-v">{{styleAnalysis.vpipPct}}</text></view>
        <view class="style-row"><text class="style-k">翻后激进度</text>
          <text class="style-v">{{styleAnalysis.aggText}}</text></view>
        <view class="style-row"><text class="style-k">摊牌胜率</text>
          <text class="style-v">{{styleAnalysis.sdWinPct}}</text></view>
        <view class="style-obs" wx:for="{{styleAnalysis.observations}}" wx:key="*this">· {{item}}</view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="sec-head"><view class="sec-ico ic ic-trophy"></view><text class="sec-title">历史战绩</text></view>
    <view class="empty" wx:if="{{recordsError}}">
      <text class="empty-icon">⚠</text>
      <text class="empty-text">战绩加载失败</text>
      <view class="empty-retry" bindtap="onRetryRecords">重试</view>
    </view>
    <view class="empty" wx:elif="{{records.length === 0}}">
      <text class="empty-icon">♠</text>
      <text class="empty-text">还没有对局记录</text>
      <text class="empty-sub">去牌桌玩一局试试</text>
    </view>
    <view class="records">
      <view class="record" wx:for="{{records}}" wx:key="id">
        <view class="rec-head">
          <text class="rec-hand">#{{item.handNo}} 手牌</text>
          <text class="rec-net {{item.net >= 0 ? 'up' : 'down'}}">{{item.net >= 0 ? '+' : ''}}{{item.net}}</text>
        </view>
        <view class="rec-body">
          <view class="rec-cards">
            <text class="rec-label">手牌</text>
            <text class="rec-val">{{item.hole}}</text>
          </view>
          <view class="rec-cards">
            <text class="rec-label">公共</text>
            <text class="rec-val">{{item.board}}</text>
          </view>
          <view class="rec-cards">
            <text class="rec-label">牌型</text>
            <text class="rec-val gold">{{item.handType}}</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 触底加载更多：加载中显示加载条，已到底显示「没有更多」 -->
    <view class="rec-more" wx:if="{{records.length > 0}}">
      <text class="rec-loading" wx:if="{{recordsLoading}}">正在加载更多…</text>
      <text class="rec-end" wx:elif="{{recordsEnd}}">没有更多战绩了</text>
    </view>
  </view>
  </block>
</view>
