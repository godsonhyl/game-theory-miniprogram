.profile {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 0%, #16302a 0%, #0d1a17 60%);
  padding: 40rpx 32rpx;
}

/* 加载骨架屏：档案与战绩读取中，占位避免全空闪烁 */
.loading-box { display: flex; flex-direction: column; align-items: center; padding-top: 20rpx; }
.loading-box .skel {
  background: rgba(255,255,255,.06); border-radius: 12rpx;
}
.loading-box .skel-circle { width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 16rpx; }
.loading-box .skel-line { height: 28rpx; margin-bottom: 12rpx; border-radius: 999rpx; }
.loading-box .skel-line.w40 { width: 40%; }
.loading-box .skel-line.w30 { width: 30%; }
.loading-box .loading-sum { display: flex; gap: 24rpx; width: 100%; margin-bottom: 40rpx; }
.loading-box .skel-num { flex: 1; height: 80rpx; border-radius: 24rpx; }
.loading-box .skel-block { width: 100%; height: 120rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.loading-tip { font-size: 22rpx; color: #6b7f78; margin-top: 12rpx; }

/* 头部 */
.head { display: flex; flex-direction: column; align-items: center; margin-bottom: 40rpx; }
.head-badge { width: 56rpx; height: 56rpx; margin-bottom: 12rpx; opacity: .9; }
.head-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(145deg, #2f9e6e, #1d6b4a);
  color: #fff; font-size: 48rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 16rpx;
}
.head-name { font-size: 34rpx; font-weight: 700; color: #eaf2ee; }
.head-sub { font-size: 22rpx; color: #8fa8a0; margin-top: 6rpx; }

/* 昵称编辑 */
.head-row { display: flex; align-items: center; justify-content: center; }
.nick-edit {
  margin-left: 16rpx; padding: 6rpx 22rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,.18); background: rgba(255,255,255,.06);
  font-size: 22rpx; color: #9fc3b4;
}
.nick-input {
  width: 440rpx; height: 72rpx; text-align: center;
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.14);
  border-radius: 16rpx; color: #eaf2ee; font-size: 30rpx; font-weight: 700;
}
.nick-ph { color: #6b7f78; font-size: 26rpx; font-weight: 400; }
.nick-ops { display: flex; margin-top: 18rpx; }
.nick-btn {
  padding: 12rpx 44rpx; margin: 0 12rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.16);
  font-size: 26rpx; color: #9fb3ab;
}
.nick-btn.primary {
  background: linear-gradient(145deg, #2f9e6e, #1d6b4a);
  color: #fff; border-color: transparent;
}
.head-tip { font-size: 20rpx; color: #6b7f78; margin-top: 10rpx; }

/* 汇总 */
.summary {
  display: flex; background: rgba(255,255,255,.05);
  border: 1rpx solid rgba(255,255,255,.09); border-radius: 24rpx;
  padding: 28rpx 0; margin-bottom: 40rpx;
}
.sum-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum-n { font-size: 36rpx; font-weight: 800; color: #d9a441; }
.sum-n.up { color: #4caf7d; }
.sum-n.down { color: #e05c4b; }
.sum-l { font-size: 20rpx; color: #8fa8a0; margin-top: 6rpx; }

/* 区块 */
.section { margin-bottom: 40rpx; }
.sec-title {
  display: block; font-size: 28rpx; font-weight: 700; color: #cfe0d9;
  margin-bottom: 20rpx;
}
.sec-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.sec-head .sec-title { margin-bottom: 0; }
.sec-ico { width: 36rpx; height: 36rpx; margin-right: 12rpx; flex: none; }

.style-card {
  background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.09);
  border-radius: 24rpx; padding: 24rpx 26rpx;
}
.style-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.05);
}
.style-row:last-child { border-bottom: none; }
.style-k { font-size: 24rpx; color: #8fa8a0; }
.style-v { font-size: 24rpx; color: #eaf2ee; }
/* 风格画像（第三期）四象限配色 */
.style-v.tight-aggressive { color: #4caf7d; }   /* 紧凶：绿 */
.style-v.loose-aggressive { color: #d9a441; }   /* 松凶：金 */
.style-v.tight-passive { color: #8fa8a0; }     /* 紧弱：灰 */
.style-v.loose-passive { color: #e05c4b; }     /* 松弱：红 */
.style-obs { font-size: 22rpx; color: #9fc3b4; line-height: 1.5; padding: 8rpx 0 0; }
.style-insufficient { font-size: 22rpx; color: #6b7f78; padding: 12rpx 0; }

/* 空状态 */
.empty { padding: 80rpx 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
.empty-icon { font-size: 80rpx; color: #2a4a42; }
.empty-text { font-size: 26rpx; color: #8fa8a0; margin-top: 20rpx; }
.empty-sub { font-size: 22rpx; color: #6b7f78; margin-top: 8rpx; }
.empty-retry { margin-top: 16rpx; padding: 10rpx 36rpx; font-size: 24rpx; color: #e8a33d; border: 1rpx solid rgba(232,163,61,.5); border-radius: 999rpx; }

/* 战绩列表 */
.record {
  background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.09);
  border-radius: 20rpx; padding: 22rpx 24rpx; margin-bottom: 18rpx;
}
.rec-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(255,255,255,.05);
  margin-bottom: 14rpx;
}
.rec-hand { font-size: 24rpx; color: #cfe0d9; font-weight: 600; }
.rec-net { font-size: 26rpx; font-weight: 700; }
.rec-net.up { color: #4caf7d; }
.rec-net.down { color: #e05c4b; }

.rec-body { display: flex; flex-direction: column; }
.rec-cards { display: flex; align-items: center; margin-bottom: 8rpx; }
.rec-label { font-size: 22rpx; color: #8fa8a0; width: 90rpx; }
.rec-val { font-size: 24rpx; color: #eaf2ee; }
.rec-val.gold { color: #d9a441; }

/* 触底加载更多：加载条 / 已到底提示 */
.rec-more { text-align: center; padding: 20rpx 0 8rpx; }
.rec-loading { font-size: 22rpx; color: #8fa8a0; }
.rec-end { font-size: 22rpx; color: #6b7f78; }

/* 战绩深化图表（方向 A）：纯 CSS，无 canvas 无图表库。
   重排红线：动态视觉只靠 transform: scaleY + opacity，不动画 width/top/left。
   颜色沿用既有色系：绿 #4caf7d / 金 #d9a441 / 红 #e05c4b / 灰 #8fa8a0。 */
.chart-card {
  background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.09);
  border-radius: 24rpx; padding: 24rpx 26rpx; margin-bottom: 18rpx;
}
.chart-title {
  font-size: 24rpx; font-weight: 600; color: #cfe0d9; margin-bottom: 18rpx;
}

/* 胜率曲线：flex 行，柱底对齐，transform: scaleY 撑柱高（transform-origin 在底部固定） */
.wr-bars {
  display: flex; align-items: flex-end; height: 140rpx; gap: 8rpx;
}
.wr-col {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  height: 120rpx;
}
.wr-bar {
  width: 60%; height: 120rpx; border-radius: 8rpx 8rpx 0 0;
  transform-origin: bottom center; transform: scaleY(0);
}
.wr-range { font-size: 18rpx; color: #6b7f78; margin-top: 6rpx; }

/* 牌型分布：横向条形，width:{{x}}% 静态内联（一次性渲染、不进 keyframe） */
.ht-list { display: flex; flex-direction: column; gap: 12rpx; }
.ht-row {
  display: flex; align-items: center; gap: 12rpx;
}
.ht-name {
  font-size: 22rpx; color: #8fa8a0; width: 120rpx; flex: none; text-align: right;
}
.ht-track {
  flex: 1; height: 20rpx; background: rgba(255,255,255,.06); border-radius: 999rpx;
  overflow: hidden;
}
.ht-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #4caf7d, #d9a441);
}
.ht-count {
  font-size: 22rpx; color: #cfe0d9; width: 48rpx; flex: none; text-align: right;
}

/* 盈亏走势：逐手柱，中心线在 50%，正柱向上、负柱向下（align-self 按 cls 定） */
.net-bars {
  display: flex; align-items: center; height: 140rpx; gap: 4rpx;
  position: relative;
}
.net-axis {
  position: absolute; left: 0; right: 0; top: 50%; height: 1rpx;
  background: rgba(255,255,255,.12);
}
.net-col {
  flex: 1; display: flex; align-items: center; justify-content: center;
  height: 120rpx;
}
.net-bar {
  width: 70%; height: 120rpx; border-radius: 4rpx;
  transform-origin: center center; transform: scaleY(0);
}
.net-bar.up {
  background: #4caf7d; transform-origin: bottom center; align-self: flex-end;
}
.net-bar.down {
  background: #e05c4b; transform-origin: top center; align-self: flex-start;
}
