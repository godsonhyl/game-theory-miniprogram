/* 牌桌页样式（横屏专用 · 微扑克式上下分区）
 *
 * 分区哲学（参考微扑克 WePoker）：
 *   - 上半区 = 对手信息 + 公共牌（只放「别人」）；
 *   - 下半区 = 我的手牌 + 筹码 + 操作按钮（单手可达、间距拉大防误触）；
 *   - 次要功能（聊天、菜单）默认折叠，不抢占主视觉。
 *
 * 配色三色原则：深灰墨绿底 + 近白文字 + 金橙高亮；绿色仅用于「跟注/过牌」与街次。
 *
 * 自适应：横向 rpx/vw，纵向统一 calc(X * var(--uh))（1uh ≈ 3.46rpx @19.5:9）。
 */
.table-page {
  /* JS 实测视口变量兜底：JS 未注入时退化为原生 vh/vw */
  --uh: 1vh;
  --uw: 1vw;
  --ink: #e8eef0;    /* 主文字（近白） */
  --mut: #93a5a0;    /* 次要文字 */
  --gold: #e8a33d;   /* 唯一高亮色（金橙） */
  height: calc(100 * var(--uh));
  box-sizing: border-box;   /* 关键：padding 计入高度，否则 100uh + 上下 padding 会把底部按钮顶出屏幕 */
  background:
    radial-gradient(ellipse at 22% 0%, rgba(232,163,61,.05) 0%, transparent 55%),
    radial-gradient(ellipse at 78% 100%, rgba(47,158,110,.05) 0%, transparent 55%),
    linear-gradient(180deg, #101c19 0%, #0b1412 100%);
  padding: calc(0.8 * var(--uh)) calc(1.4 * var(--uw));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---------- 顶栏 ---------- */
.topbar {
  height: calc(5.6 * var(--uh)); flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 calc(0.6 * var(--uw));
}
.tb-l, .tb-r { display: flex; align-items: center; }
.tb-title {
  font-size: calc(3.8 * var(--uh)); font-weight: 700; color: var(--ink);
  margin-left: calc(2 * var(--uw)); letter-spacing: calc(0.1 * var(--uh));
}
.tb-room {
  font-size: calc(2.8 * var(--uh)); color: var(--mut); margin-left: calc(1.8 * var(--uw));
  padding: calc(0.2 * var(--uh)) calc(2 * var(--uw)); border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,.12);
}
.tb-street {
  font-size: calc(2.8 * var(--uh)); font-weight: 600; color: #6fd3a4;
  background: rgba(47,158,110,.14); border: 1rpx solid rgba(78,200,146,.32);
  padding: calc(0.4 * var(--uh)) calc(2.6 * var(--uw)); border-radius: 999rpx;
}
.tb-hand { font-size: calc(2.8 * var(--uh)); color: var(--mut); margin: 0 calc(2 * var(--uw)); }
/* 盲注级（批④涨盲）：与街次/手数同级，金色药丸，tabular-nums 对齐数字 */
.tb-blind {
  font-size: calc(2.6 * var(--uh)); font-weight: 700; font-variant-numeric: tabular-nums;
  color: #ffd98a; padding: calc(0.4 * var(--uh)) calc(2.4 * var(--uw)); border-radius: 999rpx;
  background: rgba(232,163,61,.14); border: 1rpx solid rgba(232,163,61,.38);
}
.tb-clock {
  font-size: calc(2.9 * var(--uh)); font-weight: 700; font-variant-numeric: tabular-nums;
  color: #ffd98a; padding: calc(0.4 * var(--uh)) calc(2.4 * var(--uw)); border-radius: 999rpx;
  background: rgba(232,163,61,.14); border: 1rpx solid rgba(232,163,61,.38);
}
.tb-clock.urgent {
  color: #ffb3a7; background: rgba(224,92,75,.18); border-color: rgba(224,92,75,.5);
  animation: clockBlink 1s ease-in-out infinite;
}
@keyframes clockBlink { 0%,100% { opacity: 1; } 50% { opacity: .55; } }

/* 顶栏图标按钮（折叠入口） */
.ibtn {
  width: calc(5.6 * var(--uh)); height: calc(5.6 * var(--uh)); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.14);
  margin-left: calc(1.4 * var(--uw));
  position: relative;
}
.ibtn:active { background: rgba(255,255,255,.16); transform: scale(.94); }
.ibtn.on { background: rgba(232,163,61,.2); border-color: rgba(232,163,61,.55); }
.ib-txt { font-size: calc(3 * var(--uh)); line-height: 1; }
.ib-ico { width: calc(2.8 * var(--uh)); height: calc(2.8 * var(--uh)); }

/* 聊天未读徽章：折叠期间收到他人消息累计，打开面板清零 */
.chat-badge {
  position: absolute; top: calc(-1 * var(--uh)); right: calc(-1 * var(--uh));
  min-width: calc(3 * var(--uh)); height: calc(3 * var(--uh));
  background: #e5484d; color: #fff; font-size: calc(2 * var(--uh));
  border-radius: 999rpx; display: flex; align-items: center; justify-content: center;
  padding: 0 calc(0.5 * var(--uh)); z-index: 10;
}

/* ---------- 折叠菜单 ---------- */
.menu-pop {
  position: absolute; right: calc(2 * var(--uw)); top: calc(8 * var(--uh));
  background: #16251f; border: 1rpx solid rgba(255,255,255,.14);
  border-radius: calc(2.4 * var(--uh)); overflow: hidden; z-index: 40;
  box-shadow: 0 calc(1.5 * var(--uh)) calc(5 * var(--uh)) rgba(0,0,0,.6);
}
.mi {
  display: block; width: 220rpx; text-align: left;
  font-size: calc(3.2 * var(--uh)); color: var(--ink); line-height: 1.2;
  padding: calc(2 * var(--uh)) calc(3 * var(--uw));
  background: transparent; border: none; border-radius: 0;
}
.mi::after { border: none; }
.mi:active { background: rgba(255,255,255,.08); }
.mi.danger { color: #e08a7d; border-top: 1rpx solid rgba(255,255,255,.08); }

/* ---------- 牌桌（上半区：对手） ---------- */
.felt {
  flex: 1; min-height: 0; position: relative; width: 100%;
  margin-top: calc(0.4 * var(--uh));
  box-sizing: border-box;   /* 边框计入尺寸，不再额外撑出 1.6uh */
  background:
    radial-gradient(ellipse at 50% 40%, rgba(255,255,255,.05) 0%, transparent 55%),
    radial-gradient(ellipse at 50% 44%, #25604f 0%, #1a4438 45%, #0d2822 100%);
  border: calc(0.8 * var(--uh)) solid #241610;
  border-radius: 50% / 42%;
  box-shadow:
    0 0 0 1rpx rgba(232,163,61,.28),
    0 0 calc(3.4 * var(--uh)) rgba(232,163,61,.1),
    inset 0 0 calc(5 * var(--uh)) rgba(0,0,0,.45),
    0 calc(2 * var(--uh)) calc(6 * var(--uh)) rgba(0,0,0,.5);
}
.felt-glow {
  position: absolute; left: 14%; right: 14%; top: 18%; bottom: 18%;
  border-radius: 50% / 46%;
  background: radial-gradient(ellipse at 50% 46%, rgba(111,211,164,.08) 0%, transparent 65%);
  animation: glowBreath 5s ease-in-out infinite; pointer-events: none;
}
@keyframes glowBreath { 0%, 100% { opacity: .45; } 50% { opacity: .9; } }

/* ---------- 中央盘面（底池 / 公共牌） ----------
 * z-index 5 高于 .seat(3)：两侧座位的手牌压上来时让中央压住牌背。
 *
 * ⚠️ 纵向位置（2026-10-19 布局改造）：底池原固定在 top:22%，而顶排座位块是
 * 「锚点向下延伸」的——实测块底到 y≈30%≈113px，底池实心盘从 70px 就开始画，
 * 两者在 70~113px 这段必然重叠，被压住的正是最该读的「筹码 / 本轮下注」。
 * 现在底池下移到公共牌正上方（top:35%），与公共牌组成一块中央盘面，
 * 座位带（≤31%）整个让给座位。筹码飞行动画落点 POT_ANCHOR 同步改到 35。
 * 数值依据见 table.js 的 SEAT_H_PX_UH 注释（块底 30.5% vs 底池上沿 31.6%）。 */
.pot-row {
  /* ⚠️ top 必须与 table.js 的 POT_ANCHOR.y 同步（C5 2026-10-17）：
   * 底池中心坐标是筹码飞行动画的落点，两处数值不一致会出现「筹码飞进
   * 池下方」的错觉。改这里必须同步改 POT_ANCHOR。 */
  position: absolute; top: 35%; left: 50%; transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; z-index: 5;
}
.pot-row::before, .board-row::before {
  content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  border-radius: calc(2.4 * var(--uh)); z-index: -1;
}
/* 底盘高度收到与胶囊同高（原 7uh 有 3.5uh 向上溢出，正好探进座位带） */
.pot-row::before { width: 150%; height: calc(4.6 * var(--uh)); background: rgba(8,26,21,.82); }
.pot-pill {
  display: flex; align-items: baseline;
  background: rgba(5,16,13,.86); border: 1rpx solid rgba(232,163,61,.42);
  border-radius: 999rpx; padding: calc(0.5 * var(--uh)) calc(3.6 * var(--uw));
}
.pot-amount {
  font-size: calc(4.8 * var(--uh)); font-weight: 800; color: var(--gold);
  text-shadow: 0 0 calc(2.6 * var(--uh)) rgba(232,163,61,.35);
}
/* 边池：绝对定位挂在底池胶囊下方，**脱离 .pot-row 的 flex 流**
 * （2026-10-19 评审修复：多路全下时顶排座位被底池压住）。
 *
 * 病根：.side-pots 原先在 .pot-row（flex column + translate(-50%,-50%)）内部，
 * 一出现就把整个 .pot-row 撑高一行（margin-top 0.8 + 行高约 4.0 ≈ 4.8uh）。
 * 容器是 -50% 垂直居中，变高会**向上下同时延伸**：
 *     无边池：上沿 31.20% / 下沿 38.80%
 *     有边池：上沿 28.75% / 下沿 41.20%
 * 下沿距公共牌顶 42.75% 还有 1.55%，不压牌；但上沿 28.75% 已侵入顶排座位带
 * ——顶排块底固定 30.60%（ringPositions 的 pieMaxY 按 potTop=31.20 算出），
 * 重叠 1.85%，正好把 ad41992 刚修好的「顶排不被底池遮挡」在边池场景下退回。
 *
 * 修法：边池脱出文档流，绝对定位在胶囊正下方。.pot-row 高度恒为胶囊高度，
 * translate(-50%,-50%) 的基准不变，ringPositions 的 potTop 计算继续成立。
 * 横向仍居中（left:50% + translateX(-50%)），横排多池以中心对称展开。
 *
 * ⚠️ 纵向预算很紧，必须同时满足上下两侧：
 *     顶排块底 30.60% ←—0.60%—→ 胶囊上沿 31.20%
 *     胶囊下沿 38.80% ←—3.95%—→ 公共牌顶 42.75%
 * 边池只能塞进胶囊下方那 3.95%，故「间距」与「行高」一起收窄：
 *   间距 0.2uh + 行高约 3.4uh = 3.6uh < 3.95uh，留 0.38%（约 3px）余量。
 * （初版曾按 0.8+4.0=4.8uh 直接下挂，结果边池压住公共牌 0.96% —— 修一处
 *  坏一处，所以这里两侧都得算。余量刻意留够 0.35% 以上：0.15% 在 812px
 *  屏上只有 1.2px，字体行高抖动就可能吃掉。） */
.side-pots {
  position: absolute; top: calc(100% + 0.2 * var(--uh)); left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: row; align-items: center;
  white-space: nowrap;
}
.side-pot {
  /* 字号 2.6→2.2uh、padding 0.2→0.15uh：为把整行压进纵向预算。
     边池说的是「多路全下时谁有资格拿哪个池」，信息等级低于主底池一个档次，
     小一号可接受，但不能省掉（那是玩家最需要反查的细节）。 */
  font-size: calc(2.2 * var(--uh)); color: #ffd98a; background: rgba(232,163,61,.14);
  border: 1rpx solid rgba(232,163,61,.28); padding: calc(0.15 * var(--uh)) calc(2 * var(--uw));
  border-radius: 999rpx; margin: 0 calc(0.6 * var(--uw)); white-space: nowrap;
}
/* 边池归属（有资格竞争该池的座位号）：纯文字色弱化，不引新色（重排红线安全）。
 * ⚠️ 字号必须**小于**主文字（2.2 → 1.9）：本轮主文字从 2.6 压到 2.2 后，这里
 * 若仍留 2.2 就与主文字同号，原本「金额大、归属小」的视觉层级彻底消失
 * （两者挤在同一个字号，玩家分不清哪个是钱、哪个是名单）。
 * 1.9 是这一档的实测下限：再小在真机上读不清，再大则行高顶到公共牌。 */
.side-pot .sp-elig { color: rgba(255,217,138,.72); font-size: calc(1.9 * var(--uh)); }

/* 公共牌 */
/* ⚠️ 公共牌下移到 52%（2026-10-19 再修）：底池胶囊中心 35%、高 7.6uh →
 * 胶囊下沿 38.8%；牌高 18.5uh。原 top:46% 时牌顶 36.75% < 38.8%，
 * 牌面（DOM 在底池之后、同为 z-index:5）会压住底池数字的下半截 →
 * 真机「底池看不了」。52% 时牌顶 = 52−9.25 = 42.75% > 38.8%（且 clears
 * 边池行到 ~43.5%），底池完整可读；牌底 61.25% 仍远高于我的座位块顶 68.8%。 */
.board-row {
  position: absolute; top: 52%; left: 50%; transform: translate(-50%, -50%);
  display: flex; align-items: center; z-index: 5;
}
.board-row::before {
  width: 116%; height: calc(15 * var(--uh));
  background: rgba(8,26,21,.78);
}
.board { display: flex; align-items: center; }
.board .card { margin-right: calc(1.1 * var(--uw)); }

/* ---------- 扑克牌 ---------- */
.card {
  width: calc(13 * var(--uh)); height: calc(18.5 * var(--uh)); border-radius: calc(2.2 * var(--uh));
  background: linear-gradient(160deg, #fffdf7, #ece5d4);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1rpx solid rgba(0,0,0,.14);
  box-shadow: 0 calc(0.9 * var(--uh)) calc(2.4 * var(--uh)) rgba(0,0,0,.42);
  flex-shrink: 0;
  animation: dealIn .38s cubic-bezier(.2,.9,.3,1.2) both;
}
@keyframes dealIn {
  from { transform: translateY(calc(-5 * var(--uh))) rotate(-6deg) scale(.82); opacity: 0; }
  to   { transform: none; opacity: 1; }
}
.card .r { font-size: calc(5.6 * var(--uh)); font-weight: 800; line-height: 1; color: #1a1a1a; }
.card .s { font-size: calc(4.6 * var(--uh)); line-height: 1.1; color: #1a1a1a; }
/* 花色配色：默认红黑两色；根节点 .four-color 启用四色牌（♠黑 / ♣绿 / ♦蓝 / ♥红） */
.card.s-spade .r, .card.s-spade .s,
.card.s-club .r, .card.s-club .s { color: #1a1a1a; }
.card.s-diamond .r, .card.s-diamond .s,
.card.s-heart .r, .card.s-heart .s { color: #d0342c; }
.four-color .card.s-club .r, .four-color .card.s-club .s { color: #1f9d55; }
.four-color .card.s-diamond .r, .four-color .card.s-diamond .s { color: #2f6fd6; }
.four-color .card.s-spade .r, .four-color .card.s-spade .s { color: #1a1a1a; }
.four-color .card.s-heart .r, .four-color .card.s-heart .s { color: #d0342c; }

/* 摊牌时对手亮出的小牌：比常规牌小一档，让座位块更矮，中央盘面更不容易被压 */
.card-xs { width: calc(7 * var(--uh)); height: calc(9.8 * var(--uh)); border-radius: calc(1.4 * var(--uh)); }
.card-xs .r { font-size: calc(3.2 * var(--uh)); }
.card-xs .s { font-size: calc(2.6 * var(--uh)); }
/* 座位卡上的暗牌（仍在手，未摊牌）：统一用牌背 */
.card-xs.back {
  background:
    repeating-linear-gradient(45deg, rgba(255,255,255,.05) 0 calc(1.2 * var(--uh)), transparent calc(1.2 * var(--uh)) calc(2.4 * var(--uh))),
    linear-gradient(160deg, #2e5290, #1c3763);
  border: 2rpx solid rgba(232,238,245,.7);
}

.card.back {
  background:
    repeating-linear-gradient(45deg, rgba(255,255,255,.06) 0 calc(1.5 * var(--uh)), transparent calc(1.5 * var(--uh)) calc(3 * var(--uh))),
    linear-gradient(160deg, #2e5290, #1c3763);
  border: 2rpx solid rgba(232,238,245,.85);
  box-shadow: 0 calc(0.8 * var(--uh)) calc(2.2 * var(--uh)) rgba(0,0,0,.4);
}
.card.win { box-shadow: 0 0 0 calc(0.6 * var(--uh)) var(--gold), 0 0 calc(4.4 * var(--uh)) rgba(232,163,61,.7); }
/* 摊牌高亮：构成最佳成手 5 张的牌描金边并发光（GGPoker 式 best-hand 提示） */
.card.hi {
  box-shadow: 0 0 0 calc(0.5 * var(--uh)) var(--gold), 0 0 calc(3.4 * var(--uh)) rgba(232,163,61,.6);
}
.card-ph {
  width: calc(13 * var(--uh)); height: calc(18.5 * var(--uh)); border-radius: calc(2.2 * var(--uh));
  border: 2rpx dashed rgba(255,255,255,.12); background: rgba(0,0,0,.14);
  margin-right: calc(1.1 * var(--uw)); flex-shrink: 0;
}

/* ---------- 座位（仅对手） ---------- */
.seat {
  /* 锚点是块中心（pie）：x/y 落在座位块中间，块向四外延伸。
     2026-10-19 评审收口：down 排布（锚点=块顶）已删除——纵向尺寸全为 uh
     相对量，块高/池位比值不随视口变化，「窄视口触发」在数学上不存在。 */
  position: absolute; transform: translate(-50%, -50%);
  width: 104rpx; display: flex; flex-direction: column; align-items: center;
  z-index: 3;
}
.seat.folded { opacity: .38; }
.seat.standing { opacity: .42; }
/* 批⑤：SNG 淘汰——声明在 folded/standing 之后，灰显+去色覆盖二者；
   淘汰玩家 stack<=0 被 folded=true，但语义是「出局」不是「弃牌」，故独立灰显。 */
.seat.eliminated { opacity: .28; filter: grayscale(.6); }

/* 大桌（7 座及以上）紧凑模式：座位块整体缩一档，8~9 人桌环上不致挤成一团。
   只缩视觉尺寸，交互目标（头像/按钮）仍可点；小桌完全不受影响。 */
.seat.tight { width: 92rpx; }
.seat.tight .avatar {
  width: calc(7.2 * var(--uh)); height: calc(7.2 * var(--uh));
  font-size: calc(3.2 * var(--uh));
}
.seat.tight .seat-meta { max-width: 92rpx; }
.seat.tight .seat-name { font-size: calc(2.6 * var(--uh)); max-width: 56rpx; }
.seat.tight .seat-stack { font-size: calc(2.5 * var(--uh)); }
.seat.tight .stack-chip { width: calc(1.3 * var(--uh)); height: calc(1.3 * var(--uh)); margin-right: calc(0.3 * var(--uw)); }
.seat.tight .seat-bet { font-size: calc(2.6 * var(--uh)); }
.seat.tight .card-xs { width: calc(5.6 * var(--uh)); height: calc(7.8 * var(--uh)); }
.seat.tight .card-xs .r { font-size: calc(2.6 * var(--uh)); }
.seat.tight .card-xs .s { font-size: calc(2.1 * var(--uh)); }

/* 座位号（WPK 式：每个座位标位号，便于好友按号入座） */
.seat-no {
  position: absolute; top: calc(-2.2 * var(--uh)); left: calc(-3.4 * var(--uh));
  min-width: calc(4.2 * var(--uh)); height: calc(4.2 * var(--uh)); padding: 0 calc(0.6 * var(--uh));
  border-radius: 999rpx; background: rgba(10,20,17,.9);
  border: 1rpx solid rgba(255,255,255,.18);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(2.6 * var(--uh)); color: rgba(255,255,255,.62); z-index: 5; flex-shrink: 0;
}

/* 本轮下注胶囊 —— 2026-10-19 布局改造（B）：
 * 浮在锚点「上方」：座位块以锚点为中心，下注若挂在块底会继续
 * 向下延伸，把顶排块底再推低 ~4uh，正好撞上底池。浮到上方后不参与下方高度，
 * 且「钱在桌上、朝桌心方向」的观感更符合真实牌桌。 */
.seat-bet {
  /* #14 批一：本轮下注额加一档可读性（700 字重+字号 2.8→3uh）——过程数字与
     筹码同读性；tight 桌单独回缩防 8/9 人桌溢出 */
  font-size: calc(3 * var(--uh)); font-weight: 700; color: #ffd98a; background: rgba(5,16,13,.9);
  padding: calc(0.2 * var(--uh)) calc(2 * var(--uw)); border-radius: 999rpx;
  border: 1rpx solid rgba(232,163,61,.38); white-space: nowrap; z-index: 4;
  /* absolute 不占文档流，不撑高座位块；水平居中于座位块。
     默认（我的座位 / 兜底）：浮在块上方，朝桌心。 */
  position: absolute; left: 50%; bottom: calc(100% + 0.6 * var(--uh)); transform: translateX(-50%);
}
/* 对手座位：浮在座位块底部「内侧」，覆盖底牌下缘。
 * ⚠️ 不能也向上浮（2026-10-19）：顶排座位锚点 y≈15~17%，块顶只有 ~2~4%，
 * 下注胶囊在块上方还会再高 ~4.6uh → 越过牌桌上沿被裁掉，真机表现为
 * 「部分玩家下注筹码看不到」（数字上半截没了）。改到块内底部后，胶囊
 * 始终落在座位带内，且底边不超过块底（顶排块底 30.6% < 底池上沿 31.2%），
 * 既不顶出桌沿、也不侵入底池带。 */
.seat-bet.bet-in {
  bottom: auto;
  top: calc(100% - 4.8 * var(--uh));
}

.avatar {
  position: relative; width: calc(8.6 * var(--uh)); height: calc(8.6 * var(--uh)); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(3.8 * var(--uh)); font-weight: 800; color: #fff;
  background: linear-gradient(145deg, #48688f, #2c4667);
  border: 2rpx solid rgba(255,255,255,.22); flex-shrink: 0;
}
.seat.active .avatar { animation: ringPulse 1.6s ease-in-out infinite; }
@keyframes ringPulse {
  0%, 100% { box-shadow: 0 0 0 calc(0.4 * var(--uh)) rgba(232,163,61,.9), 0 0 calc(2.6 * var(--uh)) rgba(232,163,61,.5); }
  50%      { box-shadow: 0 0 0 calc(0.8 * var(--uh)) rgba(232,163,61,.5), 0 0 calc(6 * var(--uh)) rgba(232,163,61,.8); }
}
.seat.win .avatar { border-color: var(--gold); }

.dealer {
  position: absolute; top: calc(-1.4 * var(--uh)); right: calc(-1.6 * var(--uh));
  width: calc(4.8 * var(--uh)); height: calc(4.8 * var(--uh)); border-radius: 50%;
  background: linear-gradient(160deg, #f4d78a, #d9a441);
  color: #1a1a1a; border: 2rpx solid #fff;
  font-size: calc(2.6 * var(--uh)); font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 calc(0.4 * var(--uh)) calc(1.4 * var(--uh)) rgba(0,0,0,.4);
}
.timer {
  position: absolute; bottom: calc(-0.8 * var(--uh)); right: calc(-1.4 * var(--uh));
  width: calc(5.2 * var(--uh)); height: calc(5.2 * var(--uh)); border-radius: 50%;
  border: 2rpx solid rgba(15,47,39,.9);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  box-shadow: 0 0 calc(1.8 * var(--uh)) rgba(232,163,61,.35);
  transition: box-shadow .2s;
}
/* 行动计时最后 5s：计时环转红 + 脉冲（与 5s/3s 滴答警告音同步，视觉+听觉双提示） */
.timer.urgent {
  border-color: rgba(224,92,75,.9);
  box-shadow: 0 0 calc(2.4 * var(--uh)) rgba(224,92,75,.6);
  animation: timerPulse 1s ease-in-out infinite;
}
@keyframes timerPulse {
  0%, 100% { box-shadow: 0 0 calc(2.4 * var(--uh)) rgba(224,92,75,.5); }
  50%      { box-shadow: 0 0 calc(5 * var(--uh)) rgba(224,92,75,.9); }
}
.timer-num {
  width: 76%; height: 76%; border-radius: 50%;
  background: #e05c4b; color: #fff;
  font-size: calc(2.5 * var(--uh)); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

.seat-meta {
  display: flex; align-items: center; margin-top: calc(0.6 * var(--uh));
  max-width: 104rpx; overflow: hidden;
}
.seat-name {
  font-size: calc(3 * var(--uh)); color: var(--ink);
  max-width: 62rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.seat-stack {
  /* #14 批一：筹码从弱化灰（var(--mut)）升为金色+700 字重——旧样式比昵称还暗，
     「玩家看不清自己/对手筹码量」的直接病根。层级设计：昵称保持最大字号白字，
     筹码小一号但金色高亮——靠色彩差异而非尺寸抢读，「金色=钱」与 bet/pos-tag 同语义 */
  font-size: calc(2.9 * var(--uh)); color: #ffd98a; font-weight: 700;
  display: flex; align-items: center; flex: none;
  line-height: 1;
}
.stack-chip {
  /* 筹码图标（.pot-chip 的缩小版）：视觉锚定「这串数字是钱」 */
  width: calc(1.6 * var(--uh)); height: calc(1.6 * var(--uh)); border-radius: 50%;
  margin-right: calc(0.5 * var(--uw)); flex: none;
  background: radial-gradient(circle at 34% 28%, #f7e3ae, #d9a441 58%, #9d6f1c);
  border: 1rpx solid rgba(255,255,255,.45);
}
.seat-standing {
  font-size: calc(2.4 * var(--uh)); color: #7d8f8a; flex: none; margin-left: calc(0.8 * var(--uw));
  padding: 0 calc(1 * var(--uw)); border: 1rpx solid rgba(255,255,255,.14); border-radius: 999rpx;
}
/* 批⑤：SNG 淘汰名次标记（座位上的「第N名」文本） */
.seat-eliminated {
  font-size: calc(2.2 * var(--uh)); color: #ff8a72; flex: none; margin-left: calc(0.8 * var(--uw));
  padding: 0 calc(1 * var(--uw)); border: 1rpx solid rgba(255,138,114,.4); border-radius: 999rpx;
}
/* 批⑤：SNG 结算名次列文案 */
.sr-place {
  font-size: calc(3.2 * var(--uh)); font-weight: 800; color: var(--gold); flex: none;
  min-width: 96rpx; text-align: right;
}
/* 位置标记 SB/BB（庄家 D 在头像右上角） */
.pos-tags { display: flex; align-items: center; margin-top: calc(0.4 * var(--uh)); }
.pos-tags.mine { margin: 0 calc(1.2 * var(--uw)) 0 0; }
.pos-tag {
  font-size: calc(2.2 * var(--uh)); font-weight: 700; color: #ffd98a;
  background: rgba(232,163,61,.16); border: 1rpx solid rgba(232,163,61,.45);
  border-radius: 999rpx; padding: 0 calc(1.2 * var(--uw)); margin-right: calc(0.6 * var(--uw));
  line-height: calc(3.4 * var(--uh)); flex: none;
}
.pos-tag.d { background: linear-gradient(160deg, #f4d78a, #d9a441); color: #1a1a1a; border-color: #fff; }
/* 座位手牌：暗牌态紧凑叠放（第二张压在第一张上，只露右侧一条）。
   病根是原版把两张牌并排且完整排开 —— 座位块向下延伸约 130px，
   顶/中座位的手牌正好压住底池和公共牌。改为叠放后块高从 ~24uh 降到 ~14uh。
   2026-10-19 布局改造后底池已下移到公共牌上方（不再落在座位带里），
   这里的层序保留，作为「两侧座位偶尔轻微压到牌背」时的兜底。
   ⚠️ 牌是座位壳（.seat）的直接子元素，而 .seat 自带 z-index:3 会建出
   stacking context —— 这里的 z-index 只在座位壳内部有效，压不过
   z-index:5 的底池/公共牌。真正的隔离靠「块不进底池带」（锚点天花板由
   ringPositions 按块高常量现算）。
   ⚠️ 仍须显式 z-index:1：在 .seat 的层叠上下文里，z-index:auto 的定位元素
   会被 .act-bubble(z-index:4) 压下去——行动气泡会盖住亮出的牌。 */
.seat-cards { display: flex; margin-top: calc(0.4 * var(--uh)); position: relative; z-index: 1; }
.seat-cards .card-xs { margin-right: calc(0.8 * var(--uw)); }
.seat-cards .card-xs + .card-xs { margin-left: calc(-4.6 * var(--uw)); margin-right: 0; }

/* 摊牌：两张牌改为并排、完整露出来。
   摊牌是全场最该看清的一刻，叠放（-4.6uw）会让第一张被盖掉大半，
   真机上就是「 everyone 只看到一张牌，另一张被挡住」。
   摊牌时通常只剩 2~3 家没弃牌，横向空间够，不必再省那一叠。
   牌面缩小一档（-0.8uh）保证两张并排不把座位块撑太宽。 */
.seat-cards.show { z-index: 6; }
.seat-cards.show .card-xs {
  width: calc(6.2 * var(--uh)); height: calc(8.6 * var(--uh));
  border-radius: calc(1.2 * var(--uh));
}
.seat-cards.show .card-xs + .card-xs { margin-left: calc(0.6 * var(--uw)); margin-right: 0; }
.seat-cards.show .card-xs .r { font-size: calc(3 * var(--uh)); }
.seat-cards.show .card-xs .s { font-size: calc(2.4 * var(--uh)); }
/* 摊牌座位整块浮到最上层：否则相邻座位的名牌/筹码堆仍会压在刚亮出的牌上，
   等于亮了还是看不清（摊牌座位才提层，平时不动，避免打乱原有层序）。 */
.seat.reveal { z-index: 8; }

.act-bubble {
  /* 默认朝下（挂在座位块下方、朝桌心）：适用于左/右/底排座位，不挡自己底牌。 */
  position: absolute; bottom: calc(-1 * var(--uh)); left: 50%; transform: translateX(-50%);
  font-size: calc(2.6 * var(--uh)); padding: calc(0.25 * var(--uh)) calc(2 * var(--uw));
  border-radius: 999rpx; font-weight: 700; color: #fff; white-space: nowrap;
  background: #2f7d5c; border: 1rpx solid rgba(255,255,255,.16); z-index: 4;
}
/* 顶排座位：气泡改挂到座位块【顶部内侧】（2026-10-19 评审修复
 * 「顶排行动气泡被底池盖住」）。
 *
 * 病根：顶排座位块底固定 30.60%（ringPositions 的 pieMaxY 按底池上沿 31.2%
 * 推出），气泡原本向下挂（bottom:-1uh）就落进底池胶囊 31.2%~38.8%，重叠
 * 4.11%；而 .seat(z:3) 低于 .pot-row(z:5)，底池直接把气泡盖住。气泡不是一闪
 * 而过——它持续显示到换街才清（见 _lastActMap 注释），所以顶排玩家的
 * 「跟注/加注」长时间看不见。
 *
 * 为什么选「块内顶部」而不是「块外上方」：顶排块顶只有 4.2%，再往上浮
 * （气泡高约 4.1uh）会顶出牌桌上沿 0.91% 被裁掉——试过，不行。块内顶部
 * 是唯一既不越界、又不进底池的落点。
 *
 * ⚠️ 两处必须守住的约束：
 *  ① 不能给气泡 z-index —— 青蛙式地"提层级压过去"在这里是错的：
 *     .dealer（庄家 D 徽章）在头像右上外侧、top -1.4~3.4uh，与本气泡
 *     纵向重叠 3.1uh；.avatar 是 position:relative 但不建独立层叠上下文，
 *     所以两者同在 .seat 里按 z-index 排序 —— 气泡一旦设 z-index:7 就会
 *     盖住庄家徽章（庄家位置是重要信息，不能丢）。保持默认 z-index:4 即可：
 *     它仍高于 .avatar 里的首字母（auto），又低于 .act-bubble 原本的层序。
 *  ② 也不能靠 z-index 越过 .pot-row —— .seat 的 z-index:3 + transform 建了
 *     层叠上下文，座位内部 z-index 再大也出不去。真正解决遮挡的是【位置】。
 * 代价是盖住头像上半圈的首字母：头像只是身份标识，气泡文字才是行动信息，
 * 两者冲突时保文字，且庄家/倒计时徽章都在头像外侧不受影响。 */
.act-bubble.bub-top {
  bottom: auto;
  top: calc(0.3 * var(--uh));
  transform: translateX(-50%);
}
.act-f { background: #5b6470; }
.act-r { background: linear-gradient(160deg, #c98a2a, #a76d15); }
.act-a { background: linear-gradient(160deg, #e56a58, #c44a3a); }

/* ---------- 座位块高预算（与 table.js 常量同源，2026-10-19 评审收口） ----------
 * down 排布段已删除：纵向尺寸全部以 uh（视口百分比）表达，块高/池位的比值
 * 不随视口变化，「窄视口触发 down」在数学上不存在（table.js ringPositions
 * 头注释有完整推导）。改头像/名牌/SB/BB/牌背任一尺寸，必须同步
 * table.js 的 SEAT_H_PX_UH / SEAT_H_PX_UH_TIGHT，否则行为级几何断言会红：
 *   头像 8.6 + 名牌 3.6 + SB/BB 3.9 + 牌背 10.3 ≈ 26.4uh（tight 桌 ≈ 22.4uh）。 */

/* ---------- 就绪条（牌桌下沿 · 文档流 · 约 12uh） ----------
 * 结算摘要条同样走文档流；每人盈亏明细改为独立结算弹窗（resultModal），
 * 弹窗在摊牌亮牌展示约 5s 后才弹出——先亮牌后弹窗，不遮各家底牌。 */
.resultbar {
  flex-shrink: 0; display: flex; align-items: center;
  height: calc(12 * var(--uh)); box-sizing: border-box; margin-top: calc(0.6 * var(--uh));
  background: linear-gradient(180deg, rgba(8,22,18,.94), rgba(8,22,18,.8));
  border: 1rpx solid rgba(232,163,61,.42); border-radius: calc(2.4 * var(--uh));
  padding: 0 calc(1.8 * var(--uw));
}
.rb-title {
  flex: none; font-size: calc(3.4 * var(--uh)); font-weight: 700; color: var(--gold);
  margin-right: calc(2.2 * var(--uw)); white-space: nowrap;
}
.rb-sub {
  flex: 1 1 0; min-width: 0; font-size: calc(2.7 * var(--uh)); color: var(--mut);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rb-scroll { flex: 1 1 0; min-width: 0; height: calc(9.8 * var(--uh)); display: flex; align-items: center; }
.rc-chip {
  flex: none; display: flex; align-items: center; height: calc(7.8 * var(--uh));
  padding: 0 calc(2.2 * var(--uw)); margin-right: calc(1.4 * var(--uw));
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 999rpx;
}
.rc-chip.win { background: rgba(232,163,61,.16); border-color: rgba(232,163,61,.55); }
.rc-chip.on { background: rgba(232,163,61,.14); border-color: rgba(232,163,61,.5); }
.rc-name {
  font-size: calc(2.9 * var(--uh)); color: #cfe0d9; margin-right: calc(1.2 * var(--uw));
  max-width: 92rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rc-chip.win .rc-name { color: var(--gold); font-weight: 700; }
.rc-hand { font-size: calc(2.7 * var(--uh)); color: var(--mut); margin-right: calc(1 * var(--uw)); white-space: nowrap; }
.rc-gain { font-size: calc(3 * var(--uh)); color: var(--gold); font-weight: 700; white-space: nowrap; }
/* 净盈亏配色：赢 = 金色（+N，中文市场赢为暖色），输 = 灰红，平 = 暗色 */
.rc-gain.plus { color: var(--gold); }
.rc-gain.minus { color: rgba(224, 108, 96, 0.95); }
.rc-gain:not(.plus):not(.minus) { color: rgba(255, 255, 255, 0.45); }
.rc-dot {
  width: calc(1.5 * var(--uh)); height: calc(1.5 * var(--uh)); border-radius: 50%;
  background: rgba(255,255,255,.28); margin-right: calc(1 * var(--uw)); flex: none;
}
.rc-chip.on .rc-dot { background: var(--gold); }
.rc-state { font-size: calc(2.7 * var(--uh)); color: var(--mut); white-space: nowrap; }
.rc-chip.on .rc-state { color: var(--gold); }
.rb-right { flex: none; display: flex; flex-direction: column; align-items: flex-end; margin-left: calc(2 * var(--uw)); }
.rb-net { font-size: calc(2.9 * var(--uh)); color: var(--mut); white-space: nowrap; }
.rb-hint {
  font-size: calc(2.9 * var(--uh)); color: var(--mut); white-space: nowrap;
  max-width: calc(26 * var(--uw)); overflow: hidden; text-overflow: ellipsis;
}
.rb-btns { display: flex; align-items: center; margin-top: calc(0.6 * var(--uh)); }
.rb-btn {
  flex: none; margin-left: calc(1.4 * var(--uw));
  line-height: calc(7.8 * var(--uh)); padding: 0 calc(3 * var(--uw));
  font-size: calc(3.2 * var(--uh)); font-weight: 700; color: #1a1a1a;
  background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f);
  border: none; border-radius: calc(1.8 * var(--uh)); white-space: nowrap;
}
.rb-btn::after { border: none; }
.rb-btn.ghost {
  background: transparent; color: var(--gold);
  border: 1rpx solid rgba(232,163,61,.55); line-height: calc(7 * var(--uh));
}
/* 已就绪态：灰底灰字，彻底不可点（配合 wxml 的 disabled，去掉点击热区） */
.rb-btn.done {
  background: rgba(255,255,255,.07); color: rgba(255,255,255,.4);
  border: 1rpx solid rgba(255,255,255,.14);
}
.rb-btn.done::after { border: none; }
.rb-wait { margin-left: calc(1.4 * var(--uw)); font-size: calc(3 * var(--uh)); color: var(--gold); white-space: nowrap; }
/* 局内（已弃牌/本手结束未结算时）行内站起入口 */
.stand-link {
  flex: none; margin-left: calc(1.6 * var(--uw));
  font-size: calc(3 * var(--uh)); color: var(--gold);
  border: 1rpx solid rgba(232,163,61,.45); border-radius: calc(1.6 * var(--uh));
  padding: calc(0.5 * var(--uh)) calc(1.8 * var(--uw));
}
/* ---------- 我的区域（下半区） ---------- */
.myzone {
  flex-shrink: 0; margin-top: calc(0.6 * var(--uh));
  display: flex; flex-direction: column;
}
.mybar {
  display: flex; align-items: center;
  height: calc(14.5 * var(--uh));
  box-sizing: border-box;
  background: linear-gradient(170deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
  border: 1rpx solid rgba(255,255,255,.09);
  border-radius: calc(2.8 * var(--uh));
  padding: 0 calc(2.4 * var(--uw));
}
.mybar .card {
  /* 我的手牌比公共牌小一号，完整收进 mybar 不外溢 */
  width: calc(10.6 * var(--uh)); height: calc(14 * var(--uh)); border-radius: calc(1.8 * var(--uh));
}
.mybar .card .r { font-size: calc(4.4 * var(--uh)); }
.mybar .card .s { font-size: calc(3.6 * var(--uh)); }
.mybar .card.back { border-width: 2rpx; }
.mycards { display: flex; align-items: center; flex: none; position: relative; }
.mycards .card { margin-right: calc(1.2 * var(--uw)); }
.mycards.folded { opacity: .35; }
/* 当前牌型胶囊（新手可玩性 review 2026-10-19）：挂在底牌正下方，金色小字。
   .mycards 是横向 flex 且 flex:none —— 胶囊塞进同一行会把底牌挤窄，
   故用 absolute 定位到底牌容器下沿外侧（.mycards 已置 relative 作参照），
   不改变底牌布局，也不参与 mybar 的高度预算（不撑高、不顶到下方按钮区）。
   z-index 提到 3：myzone 与按钮条相邻，避免被相邻层盖住。 */
.myhand {
  position: absolute; left: 0; right: 0; top: 100%;
  margin-top: calc(0.6 * var(--uh));
  text-align: center;
  font-size: calc(1.9 * var(--uh));
  line-height: calc(2.2 * var(--uh));
  color: #e8a33d;
  font-weight: 600;
  letter-spacing: .04em;
  pointer-events: none;
  white-space: nowrap;
  z-index: 3;
}
/* 隐藏态：用 opacity/visibility 而非 wx:if —— 翻牌前→翻牌后标签在「起手牌分类」
   与「牌型名」之间切换，保留节点可让文字原地替换、不发生重排闪烁。 */
.myhand.hide { opacity: 0; visibility: hidden; }
/* 起手牌档位配色（仅翻前有 tier）：1 最强 → 5 最弱。
   暖金=可打、灰=别恋战。刻意不用大红：那会让新手以为「红色=危险，一定弃」，
   而这些标签只描述牌的类别，不构成弃/跟建议。 */
.myhand.tier-1 { color: #ffd98a; }
.myhand.tier-2 { color: #f0b95e; }
.myhand.tier-3 { color: #cfd6dd; }
.myhand.tier-4 { color: rgba(255, 255, 255, .58); }
.myhand.tier-5 { color: rgba(255, 255, 255, .40); }

.mymid {
  flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center;
  padding: 0 calc(2 * var(--uw));
}
/* 档位条：flex-wrap 兜底。档位从 6 个增到 7 个（33/50/67/100%）后，
   窄屏横屏下若仍挤在一行会溢出 mymid，故允许换行并略收窄横向内边距。 */
.presets { display: flex; align-items: center; flex-wrap: wrap; }
.pr {
  font-size: calc(3 * var(--uh)); color: var(--ink);
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.13);
  border-radius: calc(1.6 * var(--uh));
  padding: calc(0.9 * var(--uh)) calc(2.2 * var(--uw)); margin-right: calc(1.4 * var(--uw));
  white-space: nowrap;
}
.pr:last-child { margin-right: 0; }
.pr.on {
  background: rgba(232,163,61,.2); border-color: rgba(232,163,61,.75); color: #ffd98a;
  box-shadow: 0 0 calc(1.8 * var(--uh)) rgba(232,163,61,.25);
}

/* ---------- 自定义下注面板（整行两行式） ----------
 * 排版要点（旧版的病根就在这）：
 *   - 旧版把「金额输入 + 最大 N」塞进同一行文本流，又和档位条并排挤在 mymid 里，
 *     容器一窄就互相挤压 → 最大值/最小值被推出容器，压到筹码区与按钮上。
 *   - 现在：最小 / 最大是滑杆两端的「固定列」（flex:none + nowrap），滑杆 flex:1
 *     只吃剩余宽度。无论筹码是 3 位还是 7 位，两个数字都铆在两端，不可能被遮。
 * 高度预算：两行合计 ≈ 12uh，收在 mybar 的 14.5uh 之内 ——
 *   下半区总高不变，felt(flex:1) 不被压缩，座位环与公共牌不会因此被挤扁。
 */
.raise-custom {
  width: 100%; display: flex; flex-direction: column; justify-content: center;
}
.rc-axis { display: flex; align-items: center; width: 100%; }
.rc-end {
  flex: none; display: flex; align-items: baseline; white-space: nowrap;
  font-size: calc(2.6 * var(--uh)); color: var(--mut);
  padding: 0 calc(1 * var(--uw));
}
.rc-end:active .rc-num { color: var(--gold); }
.rc-num {
  font-size: calc(3.2 * var(--uh)); font-weight: 700; color: var(--ink);
  margin-left: calc(0.8 * var(--uw)); font-variant-numeric: tabular-nums;
}
.rc-slider { flex: 1; min-width: 0; height: calc(5.6 * var(--uh)); margin: 0 calc(1.4 * var(--uw)); }

.rc-edit { display: flex; align-items: center; width: 100%; margin-top: calc(0.5 * var(--uh)); }
.rc-input {
  flex: none; box-sizing: border-box;
  width: calc(13 * var(--uw)); height: calc(5.4 * var(--uh));
  text-align: center; font-weight: 700; font-size: calc(3.2 * var(--uh));
  color: #ffd98a; background: rgba(232,163,61,.1);
  border: 1rpx solid rgba(232,163,61,.42); border-radius: calc(1.4 * var(--uh));
}
.rc-q {
  flex: 1; text-align: center; white-space: nowrap; overflow: hidden;
  font-size: calc(2.8 * var(--uh)); color: var(--ink);
  line-height: calc(5.2 * var(--uh)); height: calc(5.2 * var(--uh));
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.13);
  border-radius: calc(1.4 * var(--uh));
}
.rc-q:active { background: rgba(232,163,61,.2); border-color: rgba(232,163,61,.62); }
.rc-edit .rc-q { margin-left: calc(1.4 * var(--uw)); }

/* ± 步进按钮：一个小盲注一档。flex:none 保证不被输入框挤扁 */
.rc-step {
  flex: none; width: calc(5.4 * var(--uw)); height: calc(5.2 * var(--uh));
  text-align: center; user-select: none;
  font-size: calc(3.6 * var(--uh)); font-weight: 700; line-height: calc(5 * var(--uh));
  color: #ffd98a; background: rgba(232,163,61,.12);
  border: 1rpx solid rgba(232,163,61,.42); border-radius: calc(1.4 * var(--uh));
}
.rc-step:active { background: rgba(232,163,61,.3); }
.rc-step + .rc-input { margin-left: calc(1 * var(--uw)); }
.rc-input + .rc-step { margin-left: calc(1 * var(--uw)); }
.mytip {
  font-size: calc(3 * var(--uh)); color: var(--mut); line-height: 1.35; text-align: center;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.mytip.coach { color: #ffd98a; }
.adv-main { display: block; }
.adv-explain { font-size: calc(2.6 * var(--uh)); color: #ffd98a; margin-top: calc(0.6 * var(--uh)); line-height: 1.35; }

.mystk { flex: none; display: flex; flex-direction: column; align-items: flex-end; }
.ms-v { font-size: calc(4.4 * var(--uh)); font-weight: 800; color: var(--gold); line-height: 1.1; }
/* B3 规则 3 可见反馈：已申请补筹（下一手生效）在筹码数字旁挂角标——申请
   到生效之间隔着等待，玩家必须时刻看得见「这笔钱在路上」。金色主数字里
   用浅金缩小一号区分主次。 */
.ms-pend { font-size: calc(2.4 * var(--uh)); font-weight: 700; color: #f3c98b; opacity: .9; }
.ms-l { font-size: calc(2.4 * var(--uh)); color: var(--mut); }
/* P1-7：底部我的筹码区下的 VPIP 小字——字号略小 + 色减淡，挤在「筹码」标注下
   一句微读牌数据，不抢主信息层级 */
.ms-vpip { font-size: calc(2.1 * var(--uh)); color: var(--mut); opacity: .85; margin-top: calc(0.3 * var(--uh)); }

/* 行动条：三个大按钮 + 拉大间距（微扑克：防误触）。
 * 高度再收紧到 10.8uh（2026-10-19「压缩自己的空间」）：仍远高于 44px 触控下限，
 * 把省下的 ~1uh 让给牌桌区，环形座位更舒展。 */
.actbar { display: flex; margin-top: calc(0.6 * var(--uh)); }
.ab {
  flex: 1; margin-right: calc(3.4 * var(--uw));
  line-height: calc(10.8 * var(--uh)); font-size: calc(4.4 * var(--uh)); font-weight: 700; color: #fff;
  border: none; padding: 0; border-radius: calc(2.6 * var(--uh));
}
.ab::after { border: none; }
.ab:last-child { margin-right: 0; }
.ab:active { transform: scale(.97); }
.ab[disabled] { opacity: .3; }
/* 轮到我最后 5s：行动条整体轻微脉冲，强化紧迫感（与计时环/警告音同阈值） */
.actbar.urgent { animation: actbarPulse 1s ease-in-out infinite; }
@keyframes actbarPulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.015); }
}
.ab-fold { background: linear-gradient(160deg, #5f6874, #3f4854); }
/* 弃牌二次确认态：高亮警示，避免误触一键弃牌 */
.ab-fold.confirm {
  background: linear-gradient(160deg, #d4504a, #a8332e);
  color: #fff; animation: foldPulse 1s ease-in-out infinite;
}
/* 全下二次确认态（新手可玩性 review 2026-10-19）：押上全部筹码比弃牌后果更重，
   故沿用同一套警示脉冲动画，让「再点全下」在视觉上必须被看见再点第二次。 */
.ab-raise.confirm {
  background: linear-gradient(160deg, #d4504a, #a8332e);
  color: #fff; animation: foldPulse 1s ease-in-out infinite;
}
@keyframes foldPulse {
  0%, 100% { box-shadow: 0 0 0 calc(0.3 * var(--uh)) rgba(212,80,74,.8), 0 0 calc(2.4 * var(--uh)) rgba(212,80,74,.5); }
  50%      { box-shadow: 0 0 0 calc(0.7 * var(--uh)) rgba(212,80,74,.4), 0 0 calc(5 * var(--uh)) rgba(212,80,74,.8); }
}
.ab-call { background: linear-gradient(160deg, #35b27b, #1d7a52); }
.ab-raise { background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f); color: #1a1a1a; }
/* add-bot-bar / ab-addbot 已随对局内「添加电脑玩家」入口移除（加 bot 只在等待室） */

/* ---------- 聊天浮层（默认折叠） ---------- */
.chat-pop {
  position: absolute; right: calc(1.6 * var(--uw)); top: calc(8.4 * var(--uh));
  width: 260rpx; max-height: calc(58 * var(--uh));
  display: flex; flex-direction: column; overflow: hidden;
  background: #16251f; border: 1rpx solid rgba(255,255,255,.14);
  border-radius: calc(2.6 * var(--uh)); padding: calc(1.6 * var(--uh)) calc(2 * var(--uw));
  box-shadow: 0 calc(1.5 * var(--uh)) calc(5 * var(--uh)) rgba(0,0,0,.6);
  z-index: 40;
}
.chat-log {
  flex: 1 1 0; min-height: 0; display: flex; flex-direction: column;
  gap: calc(0.5 * var(--uh)); overflow-y: auto;
}
.chat-line {
  flex: none; display: block; line-height: 1.4;
  font-size: calc(2.7 * var(--uh)); color: #cfe0d9;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.chat-empty { flex: none; display: block; font-size: calc(2.6 * var(--uh)); color: #6d837b; line-height: 1.4; }
.chat-bar { display: flex; flex-wrap: wrap; margin-top: calc(1 * var(--uh)); flex-shrink: 0; }
.chat-bar.emoji { margin-top: calc(0.6 * var(--uh)); }
.chat-quick {
  font-size: calc(2.5 * var(--uh)); color: var(--ink);
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.13);
  border-radius: calc(1.2 * var(--uh));
  padding: calc(0.4 * var(--uh)) calc(1.4 * var(--uw));
  margin: calc(0.4 * var(--uh)) calc(0.8 * var(--uw)) 0 0;
}
.chat-quick:active { background: rgba(255,255,255,.18); }
.chat-emoji { font-size: calc(3.2 * var(--uh)); line-height: 1.2; margin-right: calc(1.2 * var(--uw)); }
.chat-emoji:active { transform: scale(1.2); }

/* ---------- 等待室（好友房空房间） ---------- */
.wait-room {
  flex: 1; min-height: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: flex-start;
  padding: calc(2 * var(--uh)) calc(4 * var(--uw));
  overflow-y: auto;
}
.wait-hud { display: flex; align-items: center; justify-content: space-between; width: 100%; flex-shrink: 0; }
.hud-left-group { display: flex; align-items: center; gap: calc(3 * var(--uw)); }
.back-btn {
  font-size: calc(3.4 * var(--uh)); color: var(--ink); background: rgba(255,255,255,.08);
  border: 1rpx solid rgba(255,255,255,.18); border-radius: 999rpx;
  padding: calc(0.7 * var(--uh)) calc(3.4 * var(--uw)); line-height: 1.4;
}
.back-btn:active { background: rgba(255,255,255,.18); }
.wait-title { font-size: calc(4.4 * var(--uh)); font-weight: 700; color: var(--gold); }
.wait-roomno {
  display: flex; flex-direction: column; align-items: flex-end;
  background: rgba(232,163,61,.08); border: 1rpx solid rgba(232,163,61,.3);
  border-radius: calc(2.6 * var(--uh)); padding: calc(0.7 * var(--uh)) calc(3.4 * var(--uw));
}
.rn-num { font-size: calc(3.7 * var(--uh)); font-weight: 700; color: #ffd98a; }
.rn-copy { font-size: calc(2.6 * var(--uh)); color: var(--mut); margin-top: calc(0.3 * var(--uh)); }
.wait-set {
  font-size: calc(3 * var(--uh)); color: #ffd98a; text-align: center;
  background: rgba(232,163,61,.12); border: 1rpx solid rgba(232,163,61,.32);
  border-radius: 999rpx; padding: calc(0.7 * var(--uh)) calc(2.8 * var(--uw));
  margin-top: calc(1.8 * var(--uh)); flex-shrink: 0; align-self: center;
}
.wait-note {
  font-size: calc(3 * var(--uh)); color: var(--mut); text-align: center;
  margin: calc(1.4 * var(--uh)) 0 calc(1 * var(--uh)); line-height: 1.4; max-width: 620rpx; flex-shrink: 0;
}
.wait-tip-expire {
  font-size: calc(2.6 * var(--uh)); color: #6d837b; text-align: center;
  margin: 0 0 calc(2 * var(--uh)); line-height: 1.4; max-width: 620rpx; flex-shrink: 0;
}
.guest-wait {
  font-size: calc(2.9 * var(--uh)); color: var(--gold); text-align: center;
  margin-top: calc(1.8 * var(--uh)); flex-shrink: 0;
}
/* 自选座位提示（跨设备同步可用时显示） */
.wait-note.seat-hint { color: #ffd98a; font-weight: 600; }
.wseat:active { transform: scale(.96); }
/* 座位网格：固定宽度 + 自动换行，9 人时分两行，不再被压缩成一条 */
.wait-seats {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: calc(1.4 * var(--uh)) calc(1.6 * var(--uw)); width: 100%; max-width: 740rpx;
  flex: none; align-items: center;
}
.wseat {
  flex: 0 0 auto; width: 100rpx; height: calc(24 * var(--uh)); border-radius: calc(3 * var(--uh));
  display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;
}
.wseat.off { border: 2rpx dashed rgba(255,255,255,.16); background: rgba(255,255,255,.03); }
.wseat.on { border: 1rpx solid rgba(232,163,61,.45); background: rgba(232,163,61,.1); }
.wavatar {
  width: calc(10 * var(--uh)); height: calc(10 * var(--uh)); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(4.6 * var(--uh)); font-weight: 800; color: #fff;
  background: linear-gradient(145deg, #48688f, #2c4667); border: 2rpx solid rgba(255,255,255,.22);
}
.wavatar.empty { background: rgba(255,255,255,.04); color: #6b7d76; font-size: calc(6.4 * var(--uh)); font-weight: 400; }
.wname { font-size: calc(3 * var(--uh)); color: var(--ink); margin-top: calc(1 * var(--uh)); max-width: 96%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wname.empty { color: #6b7d76; }
.wtag {
  position: absolute; top: calc(0.8 * var(--uh)); right: calc(0.8 * var(--uh));
  font-size: calc(2.4 * var(--uh)); padding: calc(0.15 * var(--uh)) calc(1.4 * var(--uw)); border-radius: 999rpx;
}
.wtag.owner { background: linear-gradient(160deg, #f4d78a, #d9a441); color: #1a1a1a; font-weight: 700; }
.wtag.kick { background: rgba(224,92,75,.2); color: #e08a7d; border: 1rpx solid rgba(224,92,75,.4); }
.wait-actions { display: flex; align-items: stretch; gap: calc(2.6 * var(--uw)); margin-top: calc(2.6 * var(--uh)); flex-shrink: 0; }
.wbtn {
  font-size: calc(3.6 * var(--uh)); line-height: calc(11 * var(--uh)); border-radius: calc(2.6 * var(--uh)); color: #fff;
  border: none; padding: 0 calc(4.4 * var(--uw));
}
.wbtn::after { border: none; }
.wbtn.ghost { background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.18); }
.wbtn.ghost:active { background: rgba(255,255,255,.16); }
.wbtn.primary { background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f); color: #1a1a1a; font-weight: 700; }
.wbtn[disabled] { opacity: .4; }
.back-btn, .wbtn { display: flex; align-items: center; justify-content: center; }
.back-ico, .inv-ico { width: calc(2.6 * var(--uh)); height: calc(2.6 * var(--uh)); margin-right: calc(1.1 * var(--uw)); flex: none; }

/* ---------- 牌桌动画 ---------- */
/* ⚠️ betIn 必须保留 translateX(-50%)（2026-10-19 评审修复）。
 * 病根：.seat-bet 用 left:50% + transform:translateX(-50%) 做水平居中，而
 * betIn 的终帧写的是 `transform: none`；`animation-fill-mode: both` 让终帧
 * 常驻，于是动画一结束 translateX(-50%) 就被覆盖 —— 胶囊右移自身宽度的一半
 * （三位数金额约偏 5% 屏宽），且**只有开启动画时偏**：.no-anim 下 animation:none
 * 反而恢复居中。这种「关掉特效才正常」的缺陷最容易被忽略。
 * 两个 keyframes 都带 translateX(-50%)，缩放与居中各司其职。 */
.seat-bet { animation: betIn .3s cubic-bezier(.2,.9,.3,1.2) both; }
@keyframes betIn {
  from { transform: translateX(-50%) scale(.6); opacity: 0; }
  to   { transform: translateX(-50%) scale(1); opacity: 1; }
}
.pot-pill.live { animation: potPulse 2.6s ease-in-out infinite; }
@keyframes potPulse {
  0%, 100% { box-shadow: 0 0 calc(2 * var(--uh)) rgba(232,163,61,.18); }
  50%      { box-shadow: 0 0 calc(4 * var(--uh)) rgba(232,163,61,.38); }
}
/* #14 批三：换街归池脉冲——底池数字跳大瞬间胶囊弹一下，与归池筹码飞行
   配套（「桌面注码滑进底池」的画面因果）。只动 transform（重排红线）。 */
.pot-pill.pulse { animation: potPop .45s cubic-bezier(.2,.9,.3,1.3) both; }
@keyframes potPop {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.1); }
  100% { transform: scale(1); }
}
.no-anim .card,
.no-anim .felt-glow,
.no-anim .seat.active .avatar,
.no-anim .seat-bet,
.no-anim .pot-pill.live { animation: none !important; }
.no-anim .pot-pill.pulse { animation: none; }

/* ---------- 弹层：规则 / 结算 ---------- */
.help-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.68); display: flex; align-items: center; justify-content: center; z-index: 60;
}
.help-dialog {
  width: 620rpx; background: #12261f; border: 1rpx solid rgba(232,163,61,.36);
  border-radius: calc(3.2 * var(--uh)); padding: calc(3.6 * var(--uh)) calc(4 * var(--uw));
  display: flex; flex-direction: column;
}
.help-title { font-size: calc(4 * var(--uh)); font-weight: 700; color: var(--gold); text-align: center; margin-bottom: calc(1.8 * var(--uh)); }
.help-row { display: flex; align-items: baseline; padding: calc(0.7 * var(--uh)) 0; }
.help-name { font-size: calc(3 * var(--uh)); color: #ffd98a; font-weight: 700; width: 110rpx; flex: none; }
.help-desc { font-size: calc(2.9 * var(--uh)); color: #cfe0d9; flex: 1; line-height: 1.35; }
.help-tip {
  font-size: calc(2.7 * var(--uh)); color: var(--mut); line-height: 1.4; margin-top: calc(1.4 * var(--uh));
  border-left: calc(0.6 * var(--uw)) solid rgba(232,163,61,.5); padding-left: calc(2 * var(--uw));
}
.help-btn {
  margin-top: calc(2.6 * var(--uh)); line-height: calc(8.4 * var(--uh));
  font-size: calc(3.2 * var(--uh)); font-weight: 700; color: #1a1a1a;
  background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f);
  border: none; border-radius: calc(2.2 * var(--uh));
}
.help-btn::after { border: none; }

/* ---------- 批⑦：高光分享卡片（非 canvas 预览弹层） ----------
 * 复用 .hc 牌面与 .summary-btns 按钮；分享卡本体纯排版。
 * 重排红线：纯 transform/opacity + flex，无 top/left/width transition。
 * 零 canvas 硬约束（wxml 守卫已断言无 <canvas>）。 */
.share-card {
  width: 600rpx; background: linear-gradient(160deg, #1a3a36, #0f2826);
  border: 1rpx solid rgba(232,163,61,.42); border-radius: calc(3.2 * var(--uh));
  padding: calc(4 * var(--uh)) calc(4 * var(--uw));
  display: flex; flex-direction: column; align-items: center;
}
.share-card-brand {
  font-size: calc(2.6 * var(--uh)); color: var(--mut); letter-spacing: 2rpx;
}
.share-card-hand {
  font-size: calc(5.4 * var(--uh)); font-weight: 800; color: var(--gold);
  margin-top: calc(1.2 * var(--uh)); text-align: center;
}
.share-card-summary {
  font-size: calc(3 * var(--uh)); color: #cfe0d9; margin-top: calc(0.8 * var(--uh));
  text-align: center;
}
.share-card-cards {
  display: flex; margin-top: calc(2 * var(--uh));
}
.share-card-label {
  font-size: calc(2.4 * var(--uh)); color: var(--mut); margin-top: calc(2 * var(--uh));
}
.share-card-tip {
  font-size: calc(2.4 * var(--uh)); color: #6b7f78; margin-top: calc(2.2 * var(--uh));
  padding: calc(1 * var(--uh)) calc(2 * var(--uw));
  border: 1rpx dashed rgba(255,255,255,.16); border-radius: calc(1.6 * var(--uh));
}

/* ---------- 批⑥：对手画像角色卡（长按头像弹出） ----------
 * 重排红线：风格条 width 静态百分比赋值，不配 transition/keyframes；
 * 零 canvas（硬约束）。纯 transform/opacity 无关本块。 */
.opp-card {
  width: 620rpx; max-height: 86vh; overflow-y: auto;
  background: #12261f; border: 1rpx solid rgba(232,163,61,.36);
  border-radius: calc(3.2 * var(--uh)); padding: calc(3.6 * var(--uh)) calc(4 * var(--uw));
  display: flex; flex-direction: column;
}
.opp-head { display: flex; align-items: center; margin-bottom: calc(2 * var(--uh)); }
.opp-avatar {
  width: calc(11 * var(--uh)); height: calc(11 * var(--uh)); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(4.4 * var(--uh)); font-weight: 800; color: #fff;
  background: linear-gradient(145deg, #48688f, #2c4667);
  border: 2rpx solid rgba(255,255,255,.22); flex-shrink: 0;
}
.opp-head-info { margin-left: calc(3 * var(--uw)); flex: 1; }
.opp-name { font-size: calc(3.6 * var(--uh)); font-weight: 700; color: var(--ink); }
.opp-trait {
  display: inline-block; font-size: calc(2.4 * var(--uh)); color: var(--gold);
  background: rgba(232,163,61,.14); border: 1rpx solid rgba(232,163,61,.36);
  border-radius: 999rpx; padding: 0 calc(2 * var(--uw)); margin-left: calc(1.4 * var(--uw));
}
.opp-desc { display: block; font-size: calc(2.8 * var(--uh)); color: var(--mut); margin-top: calc(1 * var(--uh)); line-height: 1.4; }

.opp-section { margin-bottom: calc(2.2 * var(--uh)); }
.opp-sec-title {
  display: block; font-size: calc(2.8 * var(--uh)); font-weight: 700; color: #ffd98a;
  margin-bottom: calc(1.4 * var(--uh));
}

/* 风格条：track + fill，fill 的 width 由 JS 静态赋值，不配 transition */
.opp-bar { display: flex; align-items: center; margin-bottom: calc(1.2 * var(--uh)); }
.opp-bar-label { font-size: calc(2.6 * var(--uh)); color: var(--mut); width: 120rpx; flex: none; }
.opp-bar-track {
  flex: 1; height: calc(1.8 * var(--uh)); border-radius: 999rpx;
  background: rgba(255,255,255,.1); overflow: hidden;
}
.opp-bar-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #e8a33d, #f4d78a);
}

.opp-hint {
  display: block; font-size: calc(2.7 * var(--uh)); color: #cfe0d9;
  line-height: 1.6; padding: calc(0.4 * var(--uh)) 0;
}

.opp-stat-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(0.8 * var(--uh)) 0;
  border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.opp-stat-row:last-of-type { border-bottom: none; }
.opp-stat-k { font-size: calc(2.8 * var(--uh)); color: var(--mut); }
.opp-stat-v { font-size: calc(2.9 * var(--uh)); font-weight: 700; color: var(--ink); }

/* ---------- 牌桌内设置弹窗 ---------- */
.settings-dialog { width: 560rpx; }
.set-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(1 * var(--uh)) 0; border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.set-row:last-of-type { border-bottom: none; }
.set-name { font-size: calc(3 * var(--uh)); color: var(--ink); }
/* P0-1：AI「无限练习」行的副标题——与主名同栏叠放，字号/色阶走次级信息规格 */
.set-col { display: flex; flex-direction: column; }
.set-sub { font-size: calc(2 * var(--uh)); color: var(--mut); margin-top: calc(0.3 * var(--uh)); }
/* 开关（与首页设置弹窗一致的视觉口径） */
.switch {
  width: calc(7.2 * var(--uh)); height: calc(4.2 * var(--uh)); border-radius: 999rpx;
  background: rgba(255,255,255,.14); position: relative; transition: background .2s;
}
.switch .knob {
  position: absolute; width: calc(3.4 * var(--uh)); height: calc(3.4 * var(--uh));
  border-radius: 50%; background: #fff; top: calc(0.4 * var(--uh)); left: calc(0.4 * var(--uh));
  transition: left .2s;
}
.switch.on { background: linear-gradient(145deg, #2f9e6e, #1d6b4a); }
.switch.on .knob { left: calc(3.4 * var(--uh)); }

.summary-dialog {
  width: 640rpx; max-height: calc(86 * var(--uh));
  background: #12261f; border: 1rpx solid rgba(232,163,61,.36);
  border-radius: calc(3.2 * var(--uh)); padding: calc(3.2 * var(--uh)) calc(3.4 * var(--uw));
  display: flex; flex-direction: column;
}
.summary-title { font-size: calc(4.2 * var(--uh)); font-weight: 700; color: var(--gold); text-align: center; }
.summary-sub { font-size: calc(2.9 * var(--uh)); color: var(--mut); text-align: center; margin-top: calc(0.7 * var(--uh)); }
/* P1-6：打法画像一行——同 summary-sub 色调但更淡，避免与主信息抢焦点 */
.summary-style { font-size: calc(2.6 * var(--uh)); color: var(--mut); opacity: 0.75; text-align: center; margin-top: calc(0.5 * var(--uh)); }
.summary-rows { margin-top: calc(2 * var(--uh)); overflow-y: auto; min-height: 0; flex: 1; }
.summary-row {
  display: flex; align-items: center; box-sizing: border-box;
  min-height: calc(10.2 * var(--uh));   /* 钉死行高：有牌/无牌的行等高，列表不参差 */
  padding: calc(1 * var(--uh)) calc(1.6 * var(--uw));
  border-radius: calc(1.4 * var(--uh)); margin-bottom: calc(0.7 * var(--uh)); background: rgba(255,255,255,.04);
}
.summary-row.me { background: rgba(232,163,61,.14); border: 1rpx solid rgba(232,163,61,.36); }
/* G2：sr-main 桶把「名字+底牌+牌型」收成一块——sr-board 公共牌条插在 main 与 sr-net
   之间时，给 main 一个最小宽度让 board 自然占中间空白，否则公共牌被压到边缘 */
.sr-main { flex: 0 0 auto; display: flex; align-items: center; min-width: 0; }
/* 摊牌行名单列定宽（2026-10-17 二次反馈：仍没对齐）——单手结算弹窗的行里
   名字直接挂在 .sr-main 下（结算单的 .sr-namewrap 不经过这里），而 sr-main
   是 flex:0 0 auto 按内容伸缩：名字长短/🏆 有无会把右侧底牌列整体推得参差。
   这里同样钉死名单列宽（与 .sr-namewrap 的 16uh 同口径），各行底牌/公共牌/
   牌型/盈亏四列起点回到同一条竖线。 */
.sr-main > .sr-name { flex: 0 0 calc(16 * var(--uh)); }
.sr-rank { width: calc(5.6 * var(--uh)); font-size: calc(2.9 * var(--uh)); color: var(--mut); font-weight: 700; flex: none; }
/* 摊牌行按列对齐（2026-10-17）：名字列**钉死宽度**，否则名字长短不同会把
   右侧底牌/公共牌/牌型/盈亏四列整体推得每行不一样，看着就是「乱」。 */
.sr-namewrap { flex: none; width: calc(16 * var(--uh)); display: flex; align-items: center; overflow: hidden; margin-right: calc(1 * var(--uw)); }
.sr-name { flex: 1; font-size: calc(3.2 * var(--uh)); color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 中途离场标记：人不出单（统计覆盖所有人），但一眼可辨谁没打到底 */
.sr-left {
  flex: none; font-size: calc(2.2 * var(--uh)); color: var(--mut);
  background: rgba(255,255,255,.08); border-radius: calc(0.8 * var(--uh));
  padding: calc(0.2 * var(--uh)) calc(1 * var(--uw)); margin-left: calc(1 * var(--uw));
}
/* 带入 / 剩余 两列：与列头 .sh-num 同宽右对齐，盈亏列 .sr-net 收尾 */
.sr-buyin { width: calc(7.6 * var(--uh)); text-align: right; font-size: calc(2.9 * var(--uh)); color: var(--mut); flex: none; margin: 0 calc(1.4 * var(--uw)); }
.sr-stack { width: calc(7.6 * var(--uh)); text-align: right; font-size: calc(2.9 * var(--uh)); color: var(--mut); flex: none; margin: 0 calc(1.4 * var(--uw)); }
/* 结算单列头：与数据行逐列对齐（排名留空 / 玩家 / 带入 / 剩余 / 盈亏） */
.summary-head { display: flex; align-items: center; padding: calc(1.6 * var(--uh)) calc(1.6 * var(--uw)) 0; flex: none; }
.sh-rank { width: calc(5.6 * var(--uh)); flex: none; }
.sh-name { flex: 1; font-size: calc(2.6 * var(--uh)); color: var(--mut); margin-right: calc(1 * var(--uw)); }
.sh-num { width: calc(7.6 * var(--uh)); text-align: right; font-size: calc(2.6 * var(--uh)); color: var(--mut); flex: none; margin: 0 calc(1.4 * var(--uw)); }
.sh-net { min-width: 96rpx; text-align: right; font-size: calc(2.6 * var(--uh)); color: var(--mut); flex: none; }
/* 单手结算弹窗：牌型/状态列（摊牌=牌型名，弃牌=「弃牌」） */
/* 牌型列固定宽（右对齐）：与名字列同理，宽度随内容变会让整行参差 */
.sr-hand {
  font-size: calc(2.8 * var(--uh)); color: var(--mut); flex: none;
  margin: 0 calc(1.6 * var(--uw)); width: calc(22 * var(--uh));
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
/* 摊牌手牌（迷你牌面）：亮牌者显示两张底牌，弃牌者 cards 为空 →
   容器宽度固定（2 张牌 + 间距），列不会因有没有牌而左右错位。
   尺寸按弹窗高度预算反推：牌高 8.6uh 时 5 行仍在 640rpx 弹窗内不滚动。 */
.sr-cards {
  flex: none; display: flex; align-items: center;
  width: calc(12 * var(--uh) + 0.6 * var(--uw));
  margin: 0 calc(1.6 * var(--uw));
}
.hc {
  width: calc(6 * var(--uh)); height: calc(8.2 * var(--uh));
  flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: calc(1 * var(--uh));
  background: linear-gradient(160deg, #fffdf7, #ece5d4);
  border: 1rpx solid rgba(0,0,0,.16);
  box-shadow: 0 calc(0.3 * var(--uh)) calc(0.8 * var(--uh)) rgba(0,0,0,.3);
  color: #1a1a1a; line-height: 1;
}
.hc + .hc { margin-left: calc(0.6 * var(--uw)); }
.hc-r { font-size: calc(2.8 * var(--uh)); font-weight: 800; }
.hc-s { font-size: calc(2.4 * var(--uh)); margin-top: calc(0.2 * var(--uh)); }
/* 参与最佳成手 5 张的底牌：金边高亮，一眼看出「为什么他赢」 */
.hc.hi { border-color: var(--gold); box-shadow: 0 0 0 calc(0.5 * var(--uh)) rgba(232,163,61,.55); }
/* G2/G4 公共牌条（街分桶）：尺寸同 .hc 但视觉层级靠底色区分——公共牌条用暖灰调
   （提示「这是台面，不是他的底牌」），hi 金边与底牌同口径保持「参与成手 = 高亮」
   的全局一致性。桶内 3 段之间空开（桶标签「翻牌/转牌/河牌」前置），读牌者一眼
   区分每张牌是哪一街发出来的——新手常把 5 张搅成一锅。 */
/* 公共牌条固定宽（不 flex:1）：无论这行有没有公共牌，底牌/牌型/盈亏三列
   的起始位置都钉在同一条竖线上，纵向扫一眼就能对上每个人的牌。 */
/* ⚠️ 宽度必须容下「翻3 + 转1 + 河1」共 5 张 + 3 个街标签（约 49uh）。
 * 原 46uh + overflow:hidden 会把最右的河牌直接裁掉——只有打到河牌的局才出现，
 * 表现为「结算单有时候看不到河牌」（2026-10-21 用户反馈）。加宽到 50uh，
 * 公共牌卡略缩到 5.6uh（与底牌 6uh 区分，同时留 1~2uh 余量）。 */
.sr-board { flex: none; width: calc(50 * var(--uh)); display: flex; align-items: center;
  justify-content: flex-start; gap: calc(1.2 * var(--uw));
  margin: 0 calc(1.2 * var(--uw)); min-width: 0; overflow: hidden; }
.sr-bucket { display: flex; align-items: center; gap: calc(0.5 * var(--uw)); flex: none; }
/* 街标签精简为单字（翻/转/河）——双字标签把公共牌条撑得太宽，弹窗内放不下 */
.sr-bl {
  font-size: calc(2.0 * var(--uh)); color: var(--mut); opacity: .85;
  letter-spacing: 0; flex: none;
  /* 与 hc 居中对齐——hc 高度 ~5uh，sr-bl 单行 ~2uh，自然垂直居中 */
  padding: calc(0.3 * var(--uh)) calc(0.4 * var(--uw));
  background: rgba(255,255,255,.05); border-radius: calc(0.4 * var(--uh));
}
.sr-board .hc.bc {
  background: linear-gradient(160deg, #f5f0e2, #dcd4be);
  /* 5 张公共牌要塞进 50uh：比底牌(6uh)略小，确保河牌不被 overflow 裁掉 */
  width: calc(5.6 * var(--uh)); height: calc(7.8 * var(--uh));
}
.sr-board .hc.bc .hc-r { font-size: calc(2.6 * var(--uh)); }
.sr-board .hc.bc .hc-s { font-size: calc(2.2 * var(--uh)); }
/* .hc.degraded（盖牌弱化）已随「看全桌牌」上帝视角入口（2026-10-17）撤销退役 */
.hc.s-diamond, .hc.s-heart { color: #d0342c; }
/* 四色牌模式（根节点 .four-color）：♠黑 / ♣绿 / ♦蓝 / ♥红 */
.four-color .hc.s-club { color: #1f9d55; }
.four-color .hc.s-diamond { color: #2f6fd6; }
.sr-net { font-size: calc(3.4 * var(--uh)); font-weight: 800; color: #cfe0d9; flex: none; min-width: 96rpx; text-align: right; }
.sr-net.up { color: #ff6b5a; }
.sr-net.down { color: #4caf7d; }
/* G3 弃牌行「复盘看牌」小链接（.slink）已撤销（2026-10-17）：与底部
   「复盘这手牌」胶囊重复——摊牌行收净盈亏一列收尾，列对齐不再被行内链接扰动 */
.summary-my {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: calc(1.4 * var(--uh)); padding-top: calc(1.4 * var(--uh));
  border-top: 1rpx solid rgba(255,255,255,.1); flex: none;
}
.sm-label { font-size: calc(3 * var(--uh)); color: var(--mut); }
.sm-val { font-size: calc(4.2 * var(--uh)); font-weight: 800; color: #ffd98a; }
.sm-val.up { color: #ff6b5a; }
.sm-val.down { color: #4caf7d; }

/* ---------- 带入 / 剩余 / 盈亏 三件套 ----------
 * 结算单与「我的筹码」面板共用一套组件：玩家对账时要能一眼扫到
 * 「我带了多少 → 还剩多少 → 赚了/亏多少」，所以做成等宽三格而非行式文本。
 * 配色沿用牌桌约定：涨红跌绿（.up / .down）。 */
.sum-bank {
  display: flex; align-items: stretch; margin-top: calc(1.8 * var(--uh));
  background: rgba(255,255,255,.05); border: 1rpx solid rgba(255,255,255,.1);
  border-radius: calc(2 * var(--uh)); overflow: hidden; flex: none;
}
.sum-bank .sb-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: calc(1.4 * var(--uh)) calc(0.6 * var(--uw));
  border-right: 1rpx solid rgba(255,255,255,.08);
}
.sum-bank .sb-item:last-child { border-right: none; }
.sb-label { font-size: calc(2.5 * var(--uh)); color: var(--mut); }
.sb-val {
  font-size: calc(3.6 * var(--uh)); font-weight: 800; color: #ffd98a;
  font-variant-numeric: tabular-nums; margin-top: calc(0.3 * var(--uh));
}
.sb-val.up { color: #ff6b5a; }
.sb-val.down { color: #4caf7d; }
.sum-bank.big .sb-val { font-size: calc(4.6 * var(--uh)); }
.sum-bank.big .sb-item { padding: calc(2 * var(--uh)) calc(0.6 * var(--uw)); }

/* 实时盈亏面板的说明区 */
.bank-note {
  margin-top: calc(1.6 * var(--uh)); display: flex; flex-direction: column;
  font-size: calc(2.5 * var(--uh)); color: var(--mut); line-height: calc(3.8 * var(--uh));
}
.bank-tip { color: rgba(255,255,255,.32); margin-top: calc(0.6 * var(--uh)); }

/* 到点挂起：倒计时改为「本手后」提示，用中性灰而非红色闪烁
 *（红色 urgent 闪烁的含义是「还剩 60s  hurry」，此处含义是「已到点，等这手打完」）。 */
.tb-clock.pending {
  color: rgba(255,255,255,.72); background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.26); animation: none;
}
.summary-btns { display: flex; gap: calc(2.2 * var(--uw)); margin-top: calc(2.2 * var(--uh)); flex: none; }
.sbtn {
  flex: 1; line-height: calc(8.2 * var(--uh)); font-size: calc(3.2 * var(--uh)); font-weight: 700;
  border-radius: calc(2.2 * var(--uh)); border: none;
}
.sbtn::after { border: none; }
/* 次要按钮（如结算弹窗「复盘」）：透明底 + 描边，与 btn-primary 并排时不喧宾夺主 */
.btn-ghost.sbtn {
  flex: 0 0 auto; padding: 0 calc(4 * var(--uh));
  background: transparent; color: #e8a33d;
  border: calc(0.2 * var(--uh)) solid rgba(232,163,61,.6);
}
.btn-ghost.sbtn::after { border: none; }

/* ---------- 合并后：等待室即牌桌（座位环常显） ----------
 * 等待室与游戏中复用同一张 .felt：空座位显示虚线头像 + 「坐下」按钮，
 * 房主自己的座位描金边高亮。底部 waitbar 承载房间信息与房主操作条，
 * 视觉与 mybar 一致（微扑克式：主视觉只留牌桌 + 操作区）。 */
.seat.empty { cursor: pointer; }
.seat.empty .avatar {
  background: rgba(255,255,255,.04);
  border: 2rpx dashed rgba(255,255,255,.28); color: #6b7d76; font-weight: 400;
}
.seat.empty .seat-name { color: #6b7d76; }
.seat.empty:active { transform: translate(-50%, -50%) scale(.96); }
.seat.self .avatar { border-color: var(--gold); box-shadow: 0 0 calc(1.6 * var(--uh)) rgba(232,163,61,.42); }
.seat .sit-btn {
  margin-top: calc(0.8 * var(--uh));
  font-size: calc(2.8 * var(--uh)); font-weight: 700; color: #1a1a1a; line-height: 1.1;
  background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f);
  border-radius: 999rpx; padding: calc(0.5 * var(--uh)) calc(3.4 * var(--uw));
  white-space: nowrap; flex-shrink: 0;
}
.seat.empty:active .sit-btn { transform: scale(.95); }
/* C9（玩家审视 2026-10-17）：进行中的空位胶囊降透明——满桌打牌时空位按钮
 * 与真人座位同权重抢焦点、干扰读牌。dim 只降 .sit-btn 的可见度（不动
 * .avatar 虚线框：座位格本身仍可见，知道「这桌还能坐人」）。
 * ⚠️ cls 的 dim 只在「!readyPhase && !result」时拼上（table.js render 座位环），
 * 等待室/局间不降透——填桌是那时的主任务。opacity 属合成层属性，无重排。 */
.seat.empty.dim .sit-btn { opacity: .45; }

/* 等待室底部：房间信息 + 房主操作条 */
.wait-info {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: center;
  margin-top: calc(0.6 * var(--uh));
}
.wi-set {
  font-size: calc(3 * var(--uh)); color: #ffd98a; text-align: center;
  background: rgba(232,163,61,.12); border: 1rpx solid rgba(232,163,61,.32);
  border-radius: 999rpx; padding: calc(0.6 * var(--uh)) calc(2.8 * var(--uw));
}
.wi-hint {
  font-size: calc(2.8 * var(--uh)); color: var(--mut); text-align: center;
  margin-top: calc(0.8 * var(--uh)); line-height: 1.35; max-width: 680rpx;
}
/* 空闲超时倒计时提示：最后 5 分钟才出现，金色脉冲提醒房主拉人续房 */
.wi-idle {
  font-size: calc(2.6 * var(--uh)); color: #e8a33d; text-align: center;
  margin-top: calc(0.6 * var(--uh)); animation: idlePulse 1.6s ease-in-out infinite;
}
@keyframes idlePulse { 0%,100% { opacity: .55; } 50% { opacity: 1; } }
.waitbar {
  flex-shrink: 0; margin-top: calc(0.8 * var(--uh));
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(170deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
  border: 1rpx solid rgba(255,255,255,.09); border-radius: calc(2.8 * var(--uh));
  padding: calc(1 * var(--uh)) calc(2.4 * var(--uw));
}
.wait-actions { display: flex; align-items: stretch; gap: calc(2 * var(--uw)); }
.wait-actions .wbtn {
  font-size: calc(3.6 * var(--uh)); line-height: calc(9.5 * var(--uh)); border-radius: calc(2.6 * var(--uh)); color: #fff;
  border: none; padding: 0 calc(4.4 * var(--uw)); display: flex; align-items: center; justify-content: center;
}
/* 开始游戏：主副两行，纵向排列。
   主标题 white-space:nowrap 保证「开始游戏」四个字永不折行；
   副标题承载门槛提示（至少 2 人），不与主标题抢同一行的宽度。 */
.wait-actions .start-btn {
  flex-direction: column; align-items: center; justify-content: center;
  min-width: calc(26 * var(--uw)); padding: 0 calc(4 * var(--uw));
}
.wait-actions .sb-main {
  font-size: calc(3.8 * var(--uh)); font-weight: 700; line-height: calc(5 * var(--uh));
  white-space: nowrap; color: #1a1a1a;
}
.wait-actions .sb-sub {
  font-size: calc(2.3 * var(--uh)); line-height: calc(3.2 * var(--uh));
  white-space: nowrap; color: rgba(26,26,26,.62); font-weight: 400;
}
.wait-actions .wbtn::after { border: none; }
.wait-actions .wbtn.ghost { background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.18); }
.wait-actions .wbtn.ghost:active { background: rgba(255,255,255,.16); }
.wait-actions .wbtn.primary { background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f); color: #1a1a1a; font-weight: 700; }
.wait-actions .wbtn[disabled] { opacity: .4; }
.wait-actions .inv-ico { width: calc(2.6 * var(--uh)); height: calc(2.6 * var(--uh)); margin-right: calc(1.1 * var(--uw)); flex: none; }

/* ---------- WPK 式牌桌细节：中央筹码堆 / 下注筹码 / 状态徽章 / 赢家飘分 ---------- */
.pot-chip {
  width: calc(3 * var(--uh)); height: calc(3 * var(--uh)); border-radius: 50%;
  margin-right: calc(0.8 * var(--uw)); flex: none;
  background: radial-gradient(circle at 34% 28%, #f7e3ae, #d9a441 58%, #9d6f1c);
  border: 2rpx solid rgba(255, 255, 255, .55);
  box-shadow: 0 calc(0.3 * var(--uh)) calc(1 * var(--uh)) rgba(0, 0, 0, .35);
}
.pot-label { font-size: calc(2.4 * var(--uh)); color: rgba(255, 255, 255, .62); margin-right: calc(0.6 * var(--uw)); }
.bet-chip {
  width: calc(2.2 * var(--uh)); height: calc(2.2 * var(--uh)); border-radius: 50%;
  margin-right: calc(0.5 * var(--uw)); flex: none;
  background: radial-gradient(circle at 34% 28%, #a9e6c6, #2f9e6e 60%, #1a6446);
  border: 1rpx solid rgba(255, 255, 255, .45);
}
.seat-badges { display: flex; align-items: center; justify-content: center; margin-top: calc(0.3 * var(--uh)); }
.badge {
  font-size: calc(2.1 * var(--uh)); line-height: calc(3.2 * var(--uh));
  padding: 0 calc(0.9 * var(--uw)); border-radius: calc(1.6 * var(--uh));
  font-weight: 700; white-space: nowrap;
}
.badge.allin { background: linear-gradient(160deg, #ff8f63, #df4f43); color: #fff; }
.badge.fold { background: rgba(255, 255, 255, .1); color: rgba(255, 255, 255, .5); }
/* 就绪阶段座位徽章：已准备 = 金色实底，准备中 = 暗底灰字 */
.badge.ready { background: var(--gold); color: #1d2b25; }
.badge.prewait { background: rgba(255, 255, 255, .08); color: rgba(255, 255, 255, .55); }
/* P1-7：bot 风格标签——不抢状态徽章焦点，底色淡体现「风格提示 & 非状态」 */
.badge.style {
  background: rgba(255, 255, 255, .13); color: rgba(255, 255, 255, .78);
  border: 1rpx solid rgba(255, 255, 255, .22);
}
.seat-win {
  position: absolute; top: calc(-3.2 * var(--uh)); left: 50%;
  /* 基础居中必须写在规则里（2026-10-21 评审）：原先全靠 winPop 的
     fill-mode:both 撑住 translateX(-50%)，而 .no-anim 把 animation:none
     连同终态一起移除 → 关动画时赢钱飘字横移半个身位。
     与 .seat-bet/@keyframes betIn 同口径：基础规则管居中，keyframes 管动效。 */
  transform: translateX(-50%);
  font-size: calc(2.7 * var(--uh)); color: var(--gold); font-weight: 700; white-space: nowrap;
  text-shadow: 0 0 calc(0.9 * var(--uh)) rgba(232, 163, 61, .5);
  animation: winPop .5s cubic-bezier(.2, .9, .3, 1.3) both;
}
@keyframes winPop {
  from { opacity: 0; transform: translate(-50%, calc(1.8 * var(--uh))); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
/* C3：赢家座位牌型名（摊牌时），挂在 win 徽章下方，不动 top/left（transform 定位） */
.seat-typename {
  position: absolute; top: calc(-0.5 * var(--uh)); left: 50%; transform: translateX(-50%);
  font-size: calc(2.4 * var(--uh)); color: #fff; font-weight: 700; white-space: nowrap;
  background: rgba(5, 16, 13, .88); border: 1rpx solid rgba(232, 163, 61, .5);
  border-radius: calc(1.4 * var(--uh)); padding: 0 calc(1 * var(--uw));
  line-height: calc(3.4 * var(--uh)); z-index: 6;
  animation: winPop .5s cubic-bezier(.2, .9, .3, 1.3) both;
}
/* 摊牌牌型标注的金/灰区分（新手可玩性 review 2026-10-19）：
   此前只有赢家挂牌型名，故不需要区分。现在摊牌时所有亮牌座位都标，
   必须让「谁赢的」一眼可辨——暖金=赢家、冷灰=输家。
   输家降透明度但不隐藏文字：新手要看的就是「他是什么牌、我是什么牌」。 */
.seat-typename.win {
  color: #ffd98a; border-color: rgba(232, 163, 61, .85);
  background: rgba(44, 30, 8, .92);
}
.seat-typename.lose {
  color: rgba(255, 255, 255, .72); border-color: rgba(255, 255, 255, .22);
  background: rgba(10, 16, 22, .82);
  animation-duration: .32s;
}
.pot-odds {
  text-align: center; font-size: calc(2.6 * var(--uh)); color: rgba(255, 255, 255, .72);
  margin: calc(0.4 * var(--uh)) 0 calc(0.5 * var(--uh)); font-variant-numeric: tabular-nums;
}

/* 入座买入弹窗（WePoker 式：点空位 → 选买入额 → 入座） */
.buyin-dialog {
  width: 560rpx; background: #12261f; border: 1rpx solid rgba(232, 163, 61, .36);
  border-radius: calc(3.2 * var(--uh)); padding: calc(3 * var(--uh)) calc(3.2 * var(--uw));
  display: flex; flex-direction: column; align-items: center;
}
.buyin-title { font-size: calc(4.2 * var(--uh)); color: #fff; font-weight: 700; }
.buyin-sub { font-size: calc(2.6 * var(--uh)); color: rgba(255, 255, 255, .5); margin-top: calc(0.8 * var(--uh)); }
.buyin-opts { display: flex; flex-wrap: wrap; justify-content: center; margin: calc(1.8 * var(--uh)) 0 calc(1.2 * var(--uh)); }
.bopt {
  min-width: calc(16 * var(--uw)); text-align: center;
  font-size: calc(3.2 * var(--uh)); line-height: calc(8 * var(--uh));
  margin: calc(0.6 * var(--uh)) calc(0.8 * var(--uw));
  border-radius: calc(2 * var(--uh)); background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .16); color: #fff; font-weight: 700;
}
.bopt.on { background: linear-gradient(160deg, #f4d78a, #d9a441 60%, #b8791f); color: #1a1a1a; border-color: transparent; }
.buyin-btns { display: flex; align-items: center; }
/* B3 补筹弹窗：复用 buyin-dialog 三件套，仅输入行留出边距 */
.buyin-dialog .rc-edit { justify-content: center; margin-bottom: calc(1.2 * var(--uh)); }

/* ============================================================
 * 牌桌互动与氛围（设计文档 2026-10-15 §2）
 * 四类动画：筹码飞行 / 赢牌金光+星光粒子 / 连胜徽章 / 表情轮盘+气泡。
 * 全部只用 transform/opacity + CSS keyframes（重排红线，60fps）；
 * .no-anim 兜底统一禁用（与 card/seat-bet 同口径，关闭动画时只跳数字）。
 * 座位环坐标来自 ringPositions()，范围 x:10~90% / y:12~82%（felt 内百分比）；
 * 筹码飞行用 CSS 变量 --dx/--dy/--tx/--ty 传位移量（无单位纯数，配合 vw/vh，
 * 见 _spawnFlyOut 注释——felt 宽≈100vw 故 x 向 vw≈felt%，y 向有轻微过冲但
 * 到位前已 opacity 淡出，氛围特效不追求像素级落点）。
 * ============================================================ */

/* ---------- 赢牌金光脉冲（座位 .winfx，叠加在头像 box-shadow 上） ---------- */
.seat.winfx .avatar {
  animation: winGlow 2s ease-out 1 both;
}
@keyframes winGlow {
  0%   { box-shadow: 0 0 0 calc(0.4 * var(--uh)) rgba(232,163,61,.9), 0 0 calc(3 * var(--uh)) rgba(232,163,61,.7); }
  50%  { box-shadow: 0 0 0 calc(1.2 * var(--uh)) rgba(232,163,61,.55), 0 0 calc(8 * var(--uh)) rgba(232,163,61,.85); }
  100% { box-shadow: 0 0 0 calc(0.4 * var(--uh)) rgba(232,163,61,.2), 0 0 calc(3 * var(--uh)) rgba(232,163,61,.3); }
}

/* ---------- 连胜徽章（座位旁 🔥 xN，≥2 手显示） ---------- */
.streak-badge {
  position: absolute; top: calc(-2.6 * var(--uh)); right: calc(-1 * var(--uh));
  font-size: calc(2.2 * var(--uh)); font-weight: 800; color: var(--gold);
  background: rgba(5,16,13,.9); border: 1rpx solid rgba(232,163,61,.5);
  border-radius: 999rpx; padding: 0 calc(0.8 * var(--uw)); line-height: calc(3 * var(--uh));
  white-space: nowrap; z-index: 6;
  text-shadow: 0 0 calc(0.8 * var(--uh)) rgba(232,163,61,.5);
  animation: streakPop .4s cubic-bezier(.2,.9,.3,1.3) both;
}
@keyframes streakPop {
  from { opacity: 0; transform: scale(.6); }
  to   { opacity: 1; transform: scale(1); }
}

/* ---------- 表情气泡（座位旁，2.2s 上浮消散） ---------- */
.emote-bubble {
  position: absolute; top: calc(-4.4 * var(--uh)); left: 50%;
  font-size: calc(5.6 * var(--uh)); line-height: 1; z-index: 7;
  transform: translateX(-50%);
  animation: emoteFloat 2.2s ease-out both;
  pointer-events: none;
}
@keyframes emoteFloat {
  0%   { opacity: 0; transform: translate(-50%, calc(1.2 * var(--uh))) scale(.5); }
  15%  { opacity: 1; transform: translate(-50%, 0) scale(1.1); }
  30%  { transform: translate(-50%, 0) scale(1); }
  100% { opacity: 0; transform: translate(-50%, calc(-5 * var(--uh))) scale(1); }
}

/* ---------- 星光粒子（大牌特效，贴图 assets/spark.png） ---------- */
.spark {
  position: absolute; width: calc(4.8 * var(--uh)); height: calc(4.8 * var(--uh));
  background: url(../../assets/spark.png) center/contain no-repeat;
  pointer-events: none; z-index: 5; opacity: 0;
  animation: sparkTwinkle 2.4s ease-out both;
}
@keyframes sparkTwinkle {
  0%   { opacity: 0; }
  20%  { opacity: 1; }
  100% { opacity: 0; transform: scale(0.3) translateY(calc(-3 * var(--uh))); }
}

/* ---------- 筹码飞行层（felt 内 absolute，仅游戏中渲染） ----------
 * .fly-chip 是一枚圆形筹码代币（纯 wxss 画，零图片）：
 *  · left/top = 起点（座位坐标，felt 百分比）；
 *  · --dx/--dy = 飞行位移量（无单位，配合 vw/vh 口径）；
 *  · fly-out 用 keyframes 从起点 translate 到 (dx,dy)；
 *  · fly-in 起点在底池中心，--tx/--ty 是终点，到赢家座位。
 *  动画结束 opacity 归零，由 JS 在 bornAt+1.2/1.6s 后清场 setData 清空数组。
 */
.fly-chip {
  position: absolute; width: calc(4.4 * var(--uh)); height: calc(4.4 * var(--uh));
  border-radius: 50%; z-index: 4; pointer-events: none;
  background: radial-gradient(circle at 38% 32%, #ffe9a8, #d9a441 58%, #b8791f);
  border: 1rpx solid rgba(255,255,255,.45);
  box-shadow: 0 calc(0.3 * var(--uh)) calc(0.8 * var(--uh)) rgba(0,0,0,.4);
}
.fly-chip::after {
  content: ''; position: absolute; inset: 22%; border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,.5);
}
/* 下注入池：座位 → 底池（位移量由 --dx/--dy 传入） */
.fly-chip.fly-out {
  animation: flyChipOut 1.1s cubic-bezier(.45,.05,.55,.95) both;
}
@keyframes flyChipOut {
  0%   { opacity: 0; transform: scale(.5); }
  15%  { opacity: 1; transform: scale(1); }
  85%  { opacity: 1; transform: translate(calc(var(--dx) * 1vw), calc(var(--dy) * 1vh)) scale(.8); }
  100% { opacity: 0; transform: translate(calc(var(--dx) * 1vw), calc(var(--dy) * 1vh)) scale(.4); }
}
/* 收池到家：底池 → 赢家（终点 --tx/--ty） */
.fly-chip.fly-in {
  animation: flyChipIn 1.5s cubic-bezier(.35,.1,.5,1) both;
}
@keyframes flyChipIn {
  0%   { opacity: 0; transform: scale(.4); }
  12%  { opacity: 1; transform: scale(1); }
  88%  { opacity: 1; transform: translate(calc(var(--tx) * 1vw), calc(var(--ty) * 1vh)) scale(.9); }
  100% { opacity: 0; transform: translate(calc(var(--tx) * 1vw), calc(var(--ty) * 1vh)) scale(.5); }
}

/* ---------- 表情轮盘弹层（点头像弹出 6 格 emoji） ---------- */
.emote-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.55); z-index: 70;
  display: flex; align-items: center; justify-content: center;
}
.emote-wheel {
  width: 460rpx; background: #12261f; border: 1rpx solid rgba(232,163,61,.4);
  border-radius: calc(3.6 * var(--uh)); padding: calc(3 * var(--uh)) calc(2.4 * var(--uw));
  box-shadow: 0 calc(2 * var(--uh)) calc(8 * var(--uh)) rgba(0,0,0,.5);
  animation: wheelPop .25s cubic-bezier(.2,.9,.3,1.3) both;
}
@keyframes wheelPop {
  from { opacity: 0; transform: scale(.8); }
  to   { opacity: 1; transform: scale(1); }
}
.emote-grid { display: flex; flex-wrap: wrap; justify-content: center; }
.emote-cell {
  width: calc(15 * var(--uw)); height: calc(15 * var(--uw));
  display: flex; align-items: center; justify-content: center;
  font-size: calc(7.2 * var(--uh)); margin: calc(0.8 * var(--uw));
  border-radius: 50%; background: rgba(255,255,255,.06);
  border: 1rpx solid rgba(255,255,255,.12);
}
.emote-cell:active { transform: scale(.88); background: rgba(232,163,61,.2); }
/* 快捷语入口（轮盘底部）：观战者/在局者都可经此发一条快捷语，复用聊天面板通道 */
.emote-talk {
  margin-top: calc(1.6 * var(--uh)); padding: calc(1.2 * var(--uh)) 0;
  text-align: center; font-size: calc(3 * var(--uh)); color: var(--ink);
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.13);
  border-radius: calc(1.6 * var(--uh));
}
.emote-talk:active { background: rgba(232,163,61,.2); }

/* ---------- .no-anim 兜底：关闭动画时氛围全部禁用 ----------
 * 与既有 .no-anim .card/.seat-bet 同口径——动画关闭只跳数字/状态，
 * 飞行/粒子/金光/连胜/气泡/轮盘弹出全停（氛围特效非必要信息）。 */
.no-anim .seat.winfx .avatar,
.no-anim .streak-badge,
.no-anim .emote-bubble,
.no-anim .spark,
.no-anim .fly-chip,
.no-anim .emote-wheel { animation: none !important; }
.no-anim .spark { display: none; }

/* ---------- 结算弹窗查看类入口：平铺胶囊行（2026-10-17 二次反馈，替原二级面板） ----------
 * 复盘 / 分享 / 亮一手 直排一行小钮（「看全桌牌」已撤销），视觉降级（小字号 + ghost 描边）
 * 不与下方 primary 主操作抢层级；行内居中、放不下自动换行（3+1 颗仍单行）。
 * 上边细分隔线与按钮区隔开，高度恒定不因 canDisclose 有无而跳动。 */
.hl-row {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: calc(1.2 * var(--uw));
  margin-top: calc(1.8 * var(--uh)); padding-top: calc(1.6 * var(--uh));
  border-top: 1rpx solid rgba(255,255,255,.1); flex: none;
}
.hl-chip {
  flex: 0 0 auto; padding: 0 calc(2.6 * var(--uw));
  line-height: calc(5.6 * var(--uh)); font-size: calc(2.7 * var(--uh)); font-weight: 600;
  color: #ffd98a; background: rgba(232,163,61,.08);
  border: 1rpx solid rgba(232,163,61,.32); border-radius: 999rpx;
}
.hl-chip::after { border: none; }
.hl-chip:active { background: rgba(232,163,61,.2); transform: scale(.96); }
