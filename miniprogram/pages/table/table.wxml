<view class="table-page {{fourColor ? 'four-color' : ''}} {{animOn ? '' : 'no-anim'}}" style="{{rootStyle}}"
      bindtouchstart="onFirstTouch">
  <!-- 顶栏：好友房/AI 通用。等待室与牌桌共用，等待阶段隐藏街次/手数/倒计时 -->
  <view class="topbar">
    <view class="tb-l">
      <view class="ibtn" bindtap="onBack"><view class="ic ic-back ib-ico"></view></view>
      <text class="tb-title">{{pageTitle}}</text>
      <text class="tb-room" wx:if="{{mode === 'friend' && roomNo}}" bindtap="copyRoom">{{roomNo}}</text>
    </view>
    <view class="tb-r">
      <text class="tb-street" wx:if="{{phase === 'playing'}}">{{streetCn}}</text>
      <text class="tb-hand" wx:if="{{phase === 'playing'}}">{{handNo}} 手</text>
      <text class="tb-clock {{remainSec <= 60 ? 'urgent' : ''}}" wx:if="{{phase === 'playing' && durationMin > 0 && !timeUp}}">{{remainText}}</text>
      <view class="ibtn {{chatOpen ? 'on' : ''}}" bindtap="toggleChat" wx:if="{{phase === 'playing'}}"><text class="ib-txt">💬</text>
        <view class="chat-badge" wx:if="{{chatUnread > 0 && !chatOpen}}">{{chatUnread > 9 ? '9+' : chatUnread}}</view>
      </view>
      <view class="ibtn {{menuOpen ? 'on' : ''}}" bindtap="toggleMenu"><text class="ib-txt">⋯</text></view>
    </view>
  </view>

  <!-- 折叠菜单：次要操作收纳于此（等待室仅保留规则说明/退出房间） -->
  <view class="menu-pop" wx:if="{{menuOpen}}">
    <view class="mi" bindtap="onMenuHelp">规则说明</view>
    <view class="mi" bindtap="onMenuSettings">牌桌设置</view>
    <button class="mi" open-type="share" wx:if="{{mode === 'friend'}}">邀请好友</button>
    <view class="mi" wx:if="{{phase === 'playing' && myStanding && !mySeated}}" bindtap="onMenuSit">坐下加入游戏</view>
    <view class="mi" wx:elif="{{phase === 'playing' && canStand}}" bindtap="onMenuStand">站起退出本局</view>
    <view class="mi danger" bindtap="onMenuBack">退出房间</view>
  </view>

  <!-- 牌桌：等待室与游戏中共用同一张桌。座位环（seats）常显，
       等待阶段空座位显示「坐下」按钮，游戏中显示下注/手牌等。 -->
  <view class="felt" bindtap="closePanels">
    <view class="felt-glow"></view>

    <!-- 底池 + 边池（仅游戏中）：WPK 式中央筹码堆，带「底池」标签 -->
    <view class="pot-row" wx:if="{{phase === 'playing'}}">
      <view class="pot-pill {{pot > 0 ? 'live' : ''}}">
        <view class="pot-chip"></view>
        <text class="pot-label">底池</text>
        <text class="pot-amount">{{pot}}</text>
      </view>
      <view class="side-pots" wx:if="{{sidePots.length}}">
        <text class="side-pot" wx:for="{{sidePots}}" wx:key="index">边池{{index + 1}} {{item}}</text>
      </view>
    </view>

    <!-- 公共牌（仅游戏中） -->
    <view class="board-row" wx:if="{{phase === 'playing'}}">
      <view class="board">
        <block wx:for="{{board}}" wx:key="idx">
          <view class="card {{item.cls}} {{item.hi ? 'hi' : ''}}" style="animation-delay:{{index * 60}}ms">
            <text class="r">{{item.rank}}</text>
            <text class="s">{{item.suit}}</text>
          </view>
        </block>
        <view class="card-ph" wx:for="{{boardPlaceholders}}" wx:key="phkey"></view>
      </view>
    </view>

    <!-- 筹码飞行层（仅游戏中，absolute 在 felt 内）：下注入池 + 收池到家。
         全 transform/opacity 动画，不动 top/left（重排红线）。animOn=false 时
         数据仍下发但不挂动画（.no-anim 兜底）。 -->
    <block wx:if="{{phase === 'playing'}}">
      <view class="fly-chip fly-out" wx:for="{{flyOut}}" wx:key="key"
            style="left:{{item.x}}%;top:{{item.y}}%;--dx:{{item.dx}};--dy:{{item.dy}};animation-delay:{{item.delay}}s"></view>
      <view class="fly-chip fly-in" wx:for="{{flyIn}}" wx:key="key"
            style="left:{{item.x}}%;top:{{item.y}}%;--tx:{{item.tx}};--ty:{{item.ty}};animation-delay:{{item.delay}}s"></view>
    </block>

    <!-- 座位环：等待室与游戏中复用 -->
    <block wx:for="{{seats}}" wx:key="seat">
      <view class="seat {{item.empty ? 'empty' : ''}} {{item.isMe ? 'self' : ''}} {{item.folded ? 'folded' : ''}} {{item.active ? 'active' : ''}} {{item.win ? 'win' : ''}} {{item.standing ? 'standing' : ''}} {{winFx && (',' + winFx + ',').indexOf(',' + item.seat + ',') >= 0 ? 'winfx' : ''}}"
            style="left:{{item.x}}%;top:{{item.y}}%" bindtap="chooseSeat" data-seat="{{item.seat}}">
        <!-- 座位号（WPK 式：每个座位都标位号，便于好友按号入座） -->
        <text class="seat-no" wx:if="{{!item.empty}}">{{item.seatNo}}</text>
        <!-- 本轮下注：筹码堆 + 金额 -->
        <view class="seat-bet" wx:if="{{item.bet > 0}}"><view class="bet-chip"></view>{{item.bet}}</view>

        <view class="avatar" catchtap="onAvatarTap" data-seat="{{item.seat}}">
          <text wx:if="{{item.empty}}">＋</text>
          <text wx:else>{{item.initial}}</text>
          <view class="dealer" wx:if="{{item.isDealer}}">D</view>
          <view class="timer {{item.timerUrgent ? 'urgent' : ''}}" wx:if="{{item.active}}"
                style="background:conic-gradient({{item.timerUrgent ? '#e05c4b' : '#e8a33d'}} {{item.timerPct}}%, rgba(255,255,255,.16) 0)">
            <view class="timer-num">{{item.timer}}</view>
          </view>
        </view>

        <view class="seat-meta">
          <text class="seat-name">{{item.empty ? '空位' : item.name}}</text>
          <text class="seat-stack" wx:if="{{!item.empty && item.stack !== '' && item.stack !== undefined}}">{{item.stack}}</text>
          <text class="seat-standing" wx:if="{{item.standing}}">观战</text>
        </view>

        <!-- 位置标记：庄家 D 在头像上，SB/BB 在名牌旁（仅游戏中） -->
        <view class="pos-tags" wx:if="{{item.isSB || item.isBB}}">
          <text class="pos-tag" wx:if="{{item.isSB}}">SB</text>
          <text class="pos-tag" wx:if="{{item.isBB}}">BB</text>
        </view>

        <!-- 状态徽章：ALL-IN / 弃牌 / 就绪状态（WPK 式：状态一眼可见） -->
        <view class="seat-badges">
          <text class="badge ready" wx:if="{{item.ready === true}}">已准备</text>
          <text class="badge prewait" wx:elif="{{item.ready === false}}">准备中</text>
          <text class="badge allin" wx:if="{{item.allIn}}">ALL-IN</text>
          <text class="badge fold" wx:elif="{{item.folded}}">弃牌</text>
        </view>

        <!-- 摊牌后：赢家座位直接飘出赢得的筹码 -->
        <view class="seat-win" wx:if="{{item.win && item.winGain}}">🏆 +{{item.winGain}}</view>

        <!-- 对手底牌：摊牌时亮出；未摊牌且未弃牌时显示两张小牌背（仍在手） -->
        <view class="seat-cards" wx:if="{{item.showCards}}">
          <view class="card card-xs {{c.cls}} {{c.hi ? 'hi' : ''}}" wx:for="{{item.hole}}" wx:for-item="c" wx:key="idx">
            <text class="r">{{c.rank}}</text>
            <text class="s">{{c.suit}}</text>
          </view>
        </view>
        <view class="seat-cards" wx:elif="{{item.cardsBack}}">
          <view class="card-xs back"></view>
          <view class="card-xs back"></view>
        </view>

        <view class="act-bubble {{item.actCls}}" wx:if="{{item.actText}}">{{item.actText}}</view>

        <!-- 连胜徽章（≥2 手显示 🔥xN；新手 startHand 清零） -->
        <text class="streak-badge" wx:if="{{streaks[item.seat]}}">{{streaks[item.seat]}}</text>

        <!-- 表情气泡：每座位同时只留 1 个（新顶旧）；2.2s 后由 renderAmbience 清场 -->
        <view class="emote-bubble" wx:for="{{emotes}}" wx:for-item="em" wx:key="key"
              wx:if="{{em.seat === item.seat}}">{{em.emoji}}</view>

        <!-- 星光粒子（大牌特效）：胜者座位上方随机散布 -->
        <block wx:if="{{spark}}" wx:for="{{spark}}" wx:for-item="sp" wx:key="key">
          <view class="spark" wx:if="{{sp.seat === item.seat}}"
                style="left:{{sp.x}}%;top:{{sp.y}}%;animation-delay:{{sp.d}}s;transform:scale({{sp.s}})"></view>
        </block>

        <!-- 等待室：空座位上的「坐下」按钮 -->
        <view class="sit-btn" wx:if="{{item.empty}}">坐下</view>
        <!-- 房主可请出电脑玩家（仅等待室） -->
        <text class="wtag kick" wx:elif="{{item.isBot && isOwner && phase === 'waiting'}}" catchtap="kickBot" data-seat="{{item.seat}}">请出</text>
        <text class="wtag owner" wx:elif="{{mode === 'friend' && (item.isOwner || (item.isMe && isOwner))}}">房主</text>
      </view>
    </block>
  </view>
  <!-- /felt（就绪/结算摘要条必须位于牌桌区之后，走文档流，不得用绝对定位浮层遮牌） -->

  <!-- 就绪条：牌桌下沿的横向紧凑条。就绪状态已上座位徽章，这里只留提示与操作。
       「查看结算」与「准备就绪」并存（结算弹窗不自动弹，想看明细随时点）。 -->
  <view class="resultbar" wx:if="{{readyPhase}}">
    <text class="rb-title">等待就绪</text>
    <text class="rb-sub">各座位已亮出准备状态</text>
    <view class="rb-right">
      <text class="rb-hint">{{readyHint}}</text>
      <view class="rb-btns">
        <button class="rb-btn ghost" wx:if="{{result}}" bindtap="onShowResult">查看结算</button>
        <button class="rb-btn ghost" wx:if="{{canStand}}" bindtap="onMenuStand">站起退出本局</button>
        <button class="rb-btn ghost" wx:if="{{myStanding && !mySeated}}" bindtap="onMenuSit">坐下加入游戏</button>
        <!-- 就绪按钮：点完就地变灰禁用（不再消失成一行小字），
             否则按钮消失会让右侧布局跳动，且用户看不出「我已就绪」的确定状态 -->
        <button class="rb-btn {{myReady ? 'done' : ''}}" wx:if="{{mySeated}}"
                bindtap="onReadyTap" disabled="{{myReady}}">
          {{myReady ? '已准备' : '准备就绪'}}{{!myReady && readyLeft > 0 ? '（' + readyLeft + 's）' : ''}}
        </button>
      </view>
    </view>
  </view>
  <!-- 结算摘要条（摊牌亮牌展示期）：只留标题 + 我的盈亏 + 查看结算入口；
       结算弹窗不自动弹出，由用户点「查看结算」查看；亮牌展示结束后进就绪阶段，
       就绪条上同样保留「查看结算」入口（两个按钮并存） -->
  <view class="resultbar" wx:elif="{{result}}">
    <text class="rb-title">{{result.title}}</text>
    <text class="rb-net">{{result.netText}}</text>
    <view class="rb-right">
      <view class="rb-btns">
        <button class="rb-btn ghost" wx:if="{{canStand}}" bindtap="onMenuStand">站起退出本局</button>
        <button class="rb-btn ghost" wx:if="{{myStanding && !mySeated}}" bindtap="onMenuSit">坐下加入游戏</button>
        <button class="rb-btn" bindtap="onShowResult">查看结算</button>
      </view>
    </view>
  </view>

  <!-- 等待室底部：房间信息 + 房主操作条（好友端只显示等待提示与邀请） -->
  <block wx:if="{{phase === 'waiting'}}">
    <view class="wait-info">
      <text class="wi-set">{{maxSeats}} 人桌 · {{durationMin > 0 ? ('时长 ' + durationMin + ' 分钟') : '不限时'}}</text>
      <text class="wi-hint" wx:if="{{mode === 'friend'}}">{{isOwner ? (seatHint || '把房间号发给好友，坐下后点「开始游戏」发牌（30 分钟内无人加入自动解散）') : '已入座，等待房主开始游戏…'}}</text>
      <text class="wi-hint" wx:else>{{waitHint}}</text>
      <text class="wi-idle" wx:if="{{isOwner && idleRemainText}}">{{idleRemainText}}，拉好友或加电脑玩家续房</text>
    </view>
    <view class="waitbar">
      <view class="wait-actions">
        <button class="wbtn ghost" wx:if="{{mode === 'friend'}}" open-type="share"><view class="ic ic-share inv-ico"></view><text>邀请</text></button>
        <button class="wbtn ghost" wx:if="{{isOwner}}" bindtap="addBot">添加电脑玩家</button>
        <button class="wbtn primary" wx:if="{{isOwner}}" bindtap="startGame" disabled="{{!canStart}}">开始游戏{{canStart ? '' : '（至少 2 人）'}}</button>
      </view>
    </view>
  </block>

  <!-- 我的区域：下半区（手牌 + 状态 + 筹码 + 操作）。仅游戏中显示 -->
  <block wx:elif="{{phase === 'playing'}}">
    <view class="myzone">
      <view class="mybar">
        <view class="mycards {{myFolded ? 'folded' : ''}}">
          <view class="card {{c.cls}} {{c.hi ? 'hi' : ''}}" wx:for="{{myCards}}" wx:for-item="c" wx:key="idx" style="animation-delay:{{index * 80}}ms">
            <text class="r">{{c.rank}}</text>
            <text class="s">{{c.suit}}</text>
          </view>
          <block wx:if="{{!myCards.length && !readyPhase}}">
            <view class="card back"></view>
            <view class="card back"></view>
          </block>
        </view>

        <view class="mymid">
          <!-- 轮到我：加注档位（微扑克式 sizing chips，替代占位大的滑杆）
               自定义面板展开时收起档位条：两者曾并排挤在同一行，导致滑杆、
               「最小/最大」被压到容器外互相遮盖 —— 现在改成互斥，各占整行。 -->
          <view class="presets" wx:if="{{isMyTurn && !raiseCustom}}">
            <view class="pr {{raisePreset === item.k ? 'on' : ''}}" wx:for="{{raisePresets}}" wx:key="k"
                  data-v="{{item.k}}" bindtap="onPresetTap">{{item.t}}</view>
          </view>
          <!-- 自定义下注面板：两行布局
               第 1 行 = 最小 / 滑杆 / 最大。两端数字是滑杆的「固定轴标签」（flex:none），
                        滑杆只吃剩余宽度 → 任意筹码位数下都不会被遮盖。
                        step=raiseStep（小盲注）让滑杆只能停在盲注整数倍。
               第 2 行 = −/+ 步进 + 精确输入 + 百分比快捷额 + 收起。 -->
          <view class="raise-custom" wx:if="{{raiseCustom && legal && legal.canRaise}}">
            <view class="rc-axis">
              <view class="rc-end" bindtap="onCustomMin">最小<text class="rc-num">{{raiseMin}}</text></view>
              <slider class="rc-slider" min="{{raiseMin}}" max="{{raiseMax}}" value="{{raiseTo}}"
                      step="{{raiseStep}}" block-size="14"
                      activeColor="#e8a33d" backgroundColor="rgba(255,255,255,.16)"
                      bindchanging="onRaiseSlider" bindchange="onRaiseSlider" />
              <view class="rc-end" bindtap="onCustomMax">最大<text class="rc-num">{{raiseMax}}</text></view>
            </view>
            <view class="rc-edit">
              <view class="rc-step" bindtap="onCustomStep" data-dir="-1">−</view>
              <input class="rc-input" type="number" value="{{raiseTo}}"
                     bindinput="onRaiseInput" bindblur="onRaiseBlur" />
              <view class="rc-step" bindtap="onCustomStep" data-dir="1">+</view>
              <view class="rc-q" bindtap="onCustomPct" data-pct="0.33">33%</view>
              <view class="rc-q" bindtap="onCustomPct" data-pct="0.67">67%</view>
              <view class="rc-q" bindtap="onCustomPct" data-pct="1">100%</view>
              <view class="rc-q" bindtap="onCustomClose">收起</view>
            </view>
          </view>
          <view class="mytip" wx:elif="{{timeUp}}">本局已结束 · 可在菜单退出房间</view>
          <view class="mytip" wx:elif="{{myStanding && !mySeated}}">观战中</view>
          <view class="mytip" wx:elif="{{myStanding && mySeated}}">已坐下 · 下一手开始入局</view>
          <view class="mytip" wx:elif="{{readyPhase}}">{{myReady ? '已准备 · 等待其他人就绪…' : '上一手已结束 · 点「准备就绪」继续'}}</view>
          <view class="mytip" wx:elif="{{result}}">本手已结束 · 每人盈亏见结算弹窗或「查看结算」</view>
          <view class="mytip" wx:elif="{{myActText}}">{{myActText}}</view>
          <view class="mytip coach" wx:elif="{{coachShow}}">💡 {{coachTip}}</view>
          <view class="mytip" wx:elif="{{advice.text}}">胜率 {{advice.equityPct}} · 赔率 {{advice.potOdds}} · {{advice.text}}</view>
          <view class="mytip" wx:else>等待 {{currentPlayerName}} 行动…</view>
          <!-- 弃牌后/本手结束后（未结算面板时）：显眼的「站起退出本局」入口 -->
          <view class="stand-link" wx:if="{{canStand && !result && !readyPhase}}" bindtap="onMenuStand">站起退出本局</view>
          <!-- 站起观战中：显眼的「坐下加入游戏」入口（不进 ⋯ 菜单也能找到） -->
          <view class="stand-link" wx:if="{{myStanding && !mySeated && !readyPhase}}" bindtap="onMenuSit">坐下加入游戏</view>
        </view>

        <view class="mystk">
          <view class="pos-tags mine" wx:if="{{myDealer || mySB || myBB}}">
            <text class="pos-tag d" wx:if="{{myDealer}}">D</text>
            <text class="pos-tag" wx:if="{{mySB}}">SB</text>
            <text class="pos-tag" wx:if="{{myBB}}">BB</text>
          </view>
          <text class="ms-v">{{myStack}}</text>
          <text class="ms-l">筹码</text>
        </view>
      </view>

      <!-- 行动条：三个大按钮，间距拉大避免误触；最后 5s 整条紧迫脉冲提示 -->
      <view class="actbar {{myTimerUrgent ? 'urgent' : ''}}">
        <button class="ab ab-fold {{foldConfirm ? 'confirm' : ''}}" bindtap="onFold" disabled="{{!isMyTurn}}">{{foldConfirm ? '再点弃牌' : '弃牌'}}</button>
        <button class="ab ab-call" bindtap="onCheckOrCall" disabled="{{!isMyTurn}}">
          {{legal.toCall > 0 ? ('跟注 ' + legal.toCall) : '过牌'}}
        </button>
        <button class="ab ab-raise" bindtap="onRaise" disabled="{{!isMyTurn || !legal.canRaise}}">
          {{raiseAllIn ? '全下' : (raiseSubmit ? ('加注 ' + raiseSubmit) : '加注')}}
        </button>
      </view>
    </view>
  </block>

  <!-- 入座买入（WePoker 式）：点空位 → 选买入额 → 入座 -->
  <view class="help-mask" wx:if="{{buyInShow}}" bindtap="cancelBuyIn">
    <view class="buyin-dialog" catchtap="onBlockTap">
      <text class="buyin-title">坐下 · {{buyInSeat + 1}} 号位</text>
      <text class="buyin-sub">选择带入筹码（盲注 10/20，1000 ≈ 50BB）</text>
      <view class="buyin-opts">
        <view class="bopt {{buyInValue === item.v ? 'on' : ''}}" wx:for="{{buyInOptions}}" wx:key="v"
              data-v="{{item.v}}" bindtap="onBuyInPick">{{item.t}}</view>
      </view>
      <view class="buyin-btns">
        <button class="btn-ghost sbtn" bindtap="cancelBuyIn">取消</button>
        <button class="btn-primary sbtn" bindtap="confirmBuyIn">坐下（{{buyInValue}}）</button>
      </view>
    </view>
  </view>

  <!-- 聊天浮层：默认折叠，点击顶栏 💬 展开 -->
  <view class="chat-pop" wx:if="{{chatOpen}}">
    <view class="chat-log">
      <view class="chat-line" wx:for="{{chatLog}}" wx:key="id">{{item.name}}：{{item.text}}</view>
      <view class="chat-empty" wx:if="{{!chatLog.length}}">发个表情活跃一下牌桌气氛</view>
    </view>
    <view class="chat-bar">
      <text class="chat-quick" wx:for="{{quickChat}}" wx:key="*this" data-t="{{item}}" bindtap="onQuickChat">{{item}}</text>
    </view>
    <view class="chat-bar emoji">
      <text class="chat-emoji" wx:for="{{chatEmojis}}" wx:key="*this" data-e="{{item}}" bindtap="onEmoji">{{item}}</text>
    </view>
  </view>

  <!-- 本局结束：时长到点后的全员盈亏结算 -->
  <view class="help-mask" wx:if="{{summary}}">
    <view class="summary-dialog" catchtap="onBlockTap">
      <text class="summary-title">{{summary.title}}</text>
      <text class="summary-sub">{{summary.sub}}</text>

      <view class="summary-rows">
        <view class="summary-row {{item.isMe ? 'me' : ''}}" wx:for="{{summary.rows}}" wx:key="seat">
          <text class="sr-rank">{{index + 1}}</text>
          <text class="sr-name">{{item.name}}</text>
          <text class="sr-stack">{{item.stack}}</text>
          <text class="sr-net {{item.net > 0 ? 'up' : (item.net < 0 ? 'down' : '')}}">
            {{item.net > 0 ? '+' : ''}}{{item.net}}
          </text>
        </view>
      </view>

      <view class="summary-my">
        <text class="sm-label">我的盈亏</text>
        <text class="sm-val {{summary.myNet > 0 ? 'up' : (summary.myNet < 0 ? 'down' : '')}}">{{summary.myNetText}}</text>
      </view>

      <view class="summary-btns">
        <button class="btn-ghost sbtn" bindtap="onBack">返回房间</button>
        <button class="btn-primary sbtn" bindtap="restartGame">再来一局</button>
      </view>
    </view>
  </view>

  <!-- 单手结算弹窗：只在用户点「查看结算」时弹出（不自动打扰看牌）。
       逐人显示摊牌手牌 + 牌型 + 本手净盈亏；关闭后停留在当前阶段
       （亮牌展示期 → 进就绪；就绪期 → 留在就绪条，不重置计票）。 -->
  <view class="help-mask" wx:if="{{resultModal}}">
    <view class="summary-dialog" catchtap="onBlockTap">
      <text class="summary-title">{{resultModal.title}}</text>
      <text class="summary-sub">{{resultModal.netText}}</text>

      <view class="summary-rows">
        <view class="summary-row {{item.isMe ? 'me' : ''}}" wx:for="{{resultModal.rows}}" wx:key="seat">
          <text class="sr-name">{{item.icon}}{{item.name}}</text>
          <!-- 摊牌手牌：亮牌者的两张底牌（迷你牌面）。
               弃牌者不亮牌 → item.cards 为空，占位宽度靠 .sr-cards 固定住，列不错位。
               金边 = 该牌参与了最佳成手 5 张，一眼看出赢在哪。 -->
          <view class="sr-cards">
            <view class="hc {{c.cls}} {{c.hi ? 'hi' : ''}}" wx:for="{{item.cards}}" wx:for-item="c" wx:key="idx">
              <text class="hc-r">{{c.rank}}</text>
              <text class="hc-s">{{c.suit}}</text>
            </view>
          </view>
          <text class="sr-hand">{{item.short}}</text>
          <text class="sr-net {{item.net > 0 ? 'up' : (item.net < 0 ? 'down' : '')}}">
            {{item.net > 0 ? '+' + item.net : (item.net < 0 ? item.net : '±0')}}
          </text>
        </view>
      </view>

      <view class="summary-btns">
        <button class="btn-primary sbtn" bindtap="onResultNext">{{remoteMode || readyPhase ? '知道了' : '下一手'}}</button>
      </view>
    </view>
  </view>

  <!-- 新手引导：下注轮次与规则（等待室/牌桌通用） -->
  <view class="help-mask" wx:if="{{helpShow}}" bindtap="onHelpClose">
    <view class="help-dialog" catchtap="onBlockTap">
      <text class="help-title">怎么打完一手牌</text>
      <view class="help-row" wx:for="{{helpRows}}" wx:key="name">
        <text class="help-name">{{item.name}}</text>
        <text class="help-desc">{{item.desc}}</text>
      </view>
      <text class="help-tip">提示：牌力越强、赔率越合适越值得加注；不确定时先过牌或弃牌。</text>
      <button class="help-btn" bindtap="onHelpClose">知道了</button>
    </view>
  </view>

  <!-- 牌桌设置（菜单入口）：四色牌 / 音效 / 震动 / 动画，即时生效 -->
  <view class="help-mask" wx:if="{{settingsShow}}" bindtap="onSettingsClose">
    <view class="help-dialog settings-dialog" catchtap="onBlockTap">
      <text class="help-title">牌桌设置</text>
      <view class="set-row" bindtap="onToggleSetting" data-k="fourColor">
        <text class="set-name">四色牌</text>
        <view class="switch {{sFourColor ? 'on' : ''}}"><view class="knob"></view></view>
      </view>
      <view class="set-row" bindtap="onToggleSetting" data-k="sound">
        <text class="set-name">音效</text>
        <view class="switch {{sSound ? 'on' : ''}}"><view class="knob"></view></view>
      </view>
      <view class="set-row" bindtap="onToggleSetting" data-k="vibrate">
        <text class="set-name">震动反馈</text>
        <view class="switch {{sVibrate ? 'on' : ''}}"><view class="knob"></view></view>
      </view>
      <view class="set-row" bindtap="onToggleSetting" data-k="animation">
        <text class="set-name">牌桌动画</text>
        <view class="switch {{sAnim ? 'on' : ''}}"><view class="knob"></view></view>
      </view>
      <button class="help-btn" bindtap="onSettingsClose">完成</button>
    </view>
  </view>

  <!-- 表情轮盘（点头像弹出）：6 格 emoji，点遮罩关闭。本地即时冒泡 +
       好友房经 emote 动作上行广播（设计 §2.1）。观战者同样可发（§2.4）。 -->
  <view class="emote-mask" wx:if="{{emoteShow}}" bindtap="onEmoteClose">
    <view class="emote-wheel" catchtap="onBlockTap">
      <view class="emote-grid">
        <view class="emote-cell" wx:for="{{emoteSet}}" wx:for-item="em" wx:key="e"
              data-e="{{em.e}}" bindtap="onEmotePick">{{em.e}}</view>
      </view>
    </view>
  </view>
</view>
