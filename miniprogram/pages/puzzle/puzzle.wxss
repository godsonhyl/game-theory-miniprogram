/**
 * 每日一题页样式（纵向单列，沿用牌桌/复盘色系与四色牌）
 * 重排红线：纯文字色 + flex + padding，无 width/top/left keyframe 动画。
 * 单位用 rpx（与 profile/index 纵向页一致），不依赖 table 的 --uh/--uw 横屏变量。
 */

.puzzle-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a3a36 0%, #0f2826 100%);
  color: #e8f4f0; box-sizing: border-box;
  padding: 32rpx 32rpx 60rpx;
}

/* 顶栏 */
.pz-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.pz-back { font-size: 56rpx; color: #8fa8a0; line-height: 1; padding: 0 8rpx; }
.pz-title { font-size: 34rpx; font-weight: 700; color: #eaf2ee; }
.pz-next { font-size: 26rpx; color: #e8a33d; padding: 8rpx 22rpx; border: 1rpx solid rgba(232,163,61,.5); border-radius: 999rpx; }

/* 题目卡片 */
.pz-card {
  background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.09);
  border-radius: 24rpx; padding: 32rpx 28rpx;
}
.pz-qtitle { font-size: 34rpx; font-weight: 700; color: #e8a33d; margin-bottom: 16rpx; }
.pz-desc { font-size: 26rpx; color: #cfe0d9; line-height: 1.6; margin-bottom: 28rpx; }

/* 真人局回放标识（批⑧：高光存档构造的题） */
.pz-from-highlight {
  display: inline-block; font-size: 22rpx; color: #6bd8a0;
  background: rgba(107,216,160,.14); border: 1rpx solid rgba(107,216,160,.32);
  border-radius: 8rpx; padding: 4rpx 14rpx; margin-bottom: 14rpx;
}

/* 牌区段 */
.pz-section { margin-bottom: 24rpx; }
.pz-label { display: block; font-size: 24rpx; color: #8fa8a0; margin-bottom: 14rpx; }
.pz-cards { display: flex; gap: 16rpx; flex-wrap: wrap; }

/* 单张牌 */
.pc {
  width: 76rpx; height: 104rpx; border-radius: 12rpx; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.3);
}
.pc.r { color: #d12b2b; } .pc.d { color: #2b6ed1; } .pc.h { color: #d12b2b; } .pc.s { color: #1a1a1a; }
.pc.empty { background: transparent; border: 2rpx dashed #4a6a62; color: #4a6a62; }
.pc-r { font-size: 36rpx; font-weight: 700; line-height: 1; }
.pc-s { font-size: 30rpx; line-height: 1.2; }

/* 局面参数 */
.pz-info {
  display: flex; gap: 16rpx; margin-bottom: 32rpx;
  background: rgba(0,0,0,.18); border-radius: 16rpx; padding: 18rpx 8rpx;
}
.pz-info-row { flex: 1; display: flex; flex-direction: column; align-items: center; }
.pz-info-k { font-size: 20rpx; color: #8fa8a0; }
.pz-info-v { font-size: 30rpx; font-weight: 700; color: #e8a33d; margin-top: 4rpx; }

/* 选择按钮 */
.pz-choices { display: flex; gap: 18rpx; }
.pz-btn {
  flex: 1; text-align: center; padding: 26rpx 0; border-radius: 16rpx;
  font-size: 30rpx; font-weight: 700; border: 1rpx solid transparent;
}
.pz-btn.fold { background: rgba(224,92,75,.16); color: #ff8a72; border-color: rgba(224,92,75,.4); }
.pz-btn.check { background: rgba(143,168,160,.16); color: #cfe0d9; border-color: rgba(143,168,160,.4); }
.pz-btn.call { background: rgba(76,175,125,.16); color: #6ee7a0; border-color: rgba(76,175,125,.4); }
.pz-btn.raise { background: rgba(232,163,61,.16); color: #e8a33d; border-color: rgba(232,163,61,.4); }

/* 揭示结果 */
.pz-result {
  background: rgba(0,0,0,.2); border-radius: 16rpx; padding: 24rpx;
}
.pz-result-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.pz-result-row:last-of-type { border-bottom: none; }
.pz-result-k { font-size: 26rpx; color: #8fa8a0; }
.pz-result-v { font-size: 28rpx; font-weight: 700; color: #eaf2ee; }
.pz-result-v.ok { color: #6ee7a0; }
.pz-result-v.no { color: #ff8a72; }
.pz-explain {
  font-size: 26rpx; color: #cfe0d9; line-height: 1.7;
  margin-top: 18rpx; padding-top: 18rpx;
  border-top: 1rpx solid rgba(255,255,255,.08);
}
.pz-again {
  text-align: center; margin-top: 24rpx; padding: 18rpx 0;
  font-size: 28rpx; font-weight: 700; color: #1a3a36;
  background: linear-gradient(145deg, #e8a33d, #d9a441);
  border-radius: 16rpx;
}
