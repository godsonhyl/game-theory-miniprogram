/**
 * 全局样式
 * 注意：小程序不支持 CSS 变量，改用固定色值；
 * 单位统一用 rpx（750rpx = 屏幕宽度）。
 */

page {
  background: #0d1a17;
  color: #eaf2ee;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, input {
  box-sizing: border-box;
}

/* 通用卡片 */
.card-panel {
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 24rpx;
  padding: 26rpx;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(160deg, #d9a441, #b8791f);
  color: #1a1a1a;
  font-weight: 800;
  border-radius: 16rpx;
  border: none;
  line-height: 88rpx;
  font-size: 30rpx;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: .4; }

.btn-ghost {
  background: rgba(255, 255, 255, 0.07);
  color: #eaf2ee;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  font-weight: 600;
  border-radius: 16rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
.btn-ghost::after { border: none; }

.text-muted { color: #8fa8a0; }
.text-gold { color: #d9a441; }

