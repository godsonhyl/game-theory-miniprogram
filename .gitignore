private.*.key
*.key

# 本地配置（含 AppID 等本机特定配置，可按需保留）
# project.private.config.json

# 依赖
node_modules/

# 打包产物
dist/
preview/

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 本机特定配置（AppID / 本地路径），不进版本库
project.private.config.json
.claude/worktrees/

# 云平台下发的应用隐私清单（内部交接文件，随应用 ID 变化，不进版本库）
miniprogram/.wbapp_*.privacy.json

# Claude Code 持久化定时任务（本机会话私有，不进版本库）
.claude/scheduled_tasks.json
